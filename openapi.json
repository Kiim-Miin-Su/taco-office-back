        ]
      }
    },
    "/accounting": {
      "get": {
        "operationId": "AccountingController_all",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountingDto"
                }
              }
            }
          }
        },
        "summary": "회계 — 청구서 · 입금 · 정산. 금액은 대표만 값이 채워진다",
