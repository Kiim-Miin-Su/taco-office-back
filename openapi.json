{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "살아 있는지",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResultDto"
                }
              }
            }
          }
        },
        "summary": "로그인 — Access 는 본문, Refresh 는 httpOnly 쿠키",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResultDto"
                }
              }
            }
          }
        },
        "summary": "재발급 — 쿠키만 보고 판단한다",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "로그아웃 — 쿠키를 지운다",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          }
        },
        "summary": "내 정보 — **권한 플래그를 서버가 내려준다** (D-R39)",
        "tags": [
          "auth"
        ]
      }
    },
    "/meta": {
      "get": {
        "operationId": "MetaController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaDto"
                }
              }
            }
          }
        },
        "summary": "코드표 — 수업 종류 · 과목 · 강의실 · 줌 · 구성원 · 학생",
        "tags": [
          "meta"
        ]
      }
    },
    "/schedule/occurrences": {
      "get": {
        "operationId": "ScheduleController_list",
        "parameters": [
          {
            "name": "from",
            "required": true,
            "in": "query",
            "schema": {
              "example": "2026-08-24",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": true,
            "in": "query",
            "schema": {
              "example": "2026-08-30",
              "type": "string"
            }
          },
          {
            "name": "teacherId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "studentId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "roomId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrenceListDto"
                }
              }
            }
          }
        },
        "summary": "회차 목록 — 일간·주간·월간·학생별·선생님별이 모두 이것을 쓴다",
        "tags": [
          "schedule"
        ]
      }
    }
  },
  "info": {
    "title": "TACO ERP API",
    "description": "티엔아카데미 학원 운영 백오피스 — 개발 명세서 v2 기준",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "kim@tnacademy.kr"
          },
          "password": {
            "type": "string",
            "example": "********"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "manager",
              "admin",
              "ceo"
            ]
          },
          "title": {
            "type": "object",
            "nullable": true,
            "description": "직함 — 권한과 무관"
          },
          "canAdminPage": {
            "type": "boolean",
            "description": "관리자 백오피스 진입"
          },
          "canCrudAll": {
            "type": "boolean",
            "description": "전 항목 CRUD"
          },
          "canSeeProfit": {
            "type": "boolean",
            "description": "지출 · 총수입 — 대표 전용"
          },
          "canCrudAttendance": {
            "type": "boolean",
            "description": "오늘·이전 스케줄 출결 (D-R35)"
          },
          "canMoney": {
            "type": "boolean"
          },
          "canWage": {
            "type": "boolean"
          },
          "canApprove": {
            "type": "boolean"
          },
          "canHide": {
            "type": "boolean"
          },
          "canGpaPack": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "title",
          "canAdminPage",
          "canCrudAll",
          "canSeeProfit",
          "canCrudAttendance",
          "canMoney",
          "canWage",
          "canApprove",
          "canHide",
          "canGpaPack"
        ]
      },
      "LoginResultDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access 토큰 (15분). Refresh 는 httpOnly 쿠키로 나갑니다"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "RefreshResultDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "KindDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "토큰과 같은 값 — 화면은 이 색을 쓰기만 한다"
          },
          "cap": {
            "type": "number"
          },
          "grp": {
            "type": "string",
            "enum": [
              "lesson",
              "intake",
              "meeting"
            ]
          },
          "rep": {
            "type": "boolean",
            "description": "리포트 대상인가 (D-4)"
          }
        },
        "required": [
          "key",
          "name",
          "color",
          "cap",
          "grp",
          "rep"
        ]
      },
      "SubDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "color"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "branch": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "branch",
          "name"
        ]
      },
      "ZaccDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "meetingId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "StaffBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "manager",
              "admin",
              "ceo"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "표시용 직함 — 권한과 무관하다 (D-R39)"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "StudentBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "nullable": true
          },
          "school": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KindDto"
            }
          },
          "subs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubDto"
            }
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomDto"
            }
          },
          "zaccs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ZaccDto"
            }
          },
          "staff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffBriefDto"
            }
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudentBriefDto"
            }
          }
        },
        "required": [
          "kinds",
          "subs",
          "rooms",
          "zaccs",
          "staff",
          "students"
        ]
      },
      "OccStudentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "nullable": true
          },
          "droppedOnce": {
            "type": "boolean",
            "description": "그날만 빠진 학생인가 (D-R21)"
          }
        },
        "required": [
          "id",
          "name",
          "droppedOnce"
        ]
      },
      "OccurrenceDto": {
        "type": "object",
        "properties": {
          "serId": {
            "type": "number",
            "description": "반복 규칙 id"
          },
          "date": {
            "type": "string",
            "example": "2026-08-28"
          },
          "startMin": {
            "type": "number",
            "description": "자정부터 분"
          },
          "endMin": {
            "type": "number"
          },
          "kindKey": {
            "type": "string"
          },
          "subKey": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "teacherId": {
            "type": "number",
            "nullable": true
          },
          "teacherName": {
            "type": "string",
            "nullable": true
          },
          "roomId": {
            "type": "number",
            "nullable": true
          },
          "roomName": {
            "type": "string",
            "nullable": true
          },
          "zaccId": {
            "type": "number",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "offline",
              "online"
            ]
          },
          "canceled": {
            "type": "boolean"
          },
          "hasException": {
            "type": "boolean",
            "description": "이 회차에 예외가 붙었는가"
          },
          "repState": {
            "type": "string",
            "enum": [
              "na",
              "plan",
              "none",
              "draft",
              "wait",
              "ok",
              "rej"
            ],
            "description": "리포트 상태. 캘린더 블록 색이 이 값에서 나온다 (D-R7 · V26 §2.3)"
          },
          "written": {
            "type": "boolean",
            "description": "리포트를 썼는가 — 정산에 들어가는 조건 하나 (D-R7)"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OccStudentDto"
            }
          }
        },
        "required": [
          "serId",
          "date",
          "startMin",
          "endMin",
          "kindKey",
          "mode",
          "canceled",
          "hasException",
          "repState",
          "written",
          "students"
        ]
      },
      "OccurrenceListDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "example": "2026-08-24"
          },
          "to": {
            "type": "string",
            "example": "2026-08-30"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OccurrenceDto"
            }
          }
        },
        "required": [
          "from",
          "to",
          "items"
        ]
      }
    }
  }
}
