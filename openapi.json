  "info": {
    "title": "TACO ERP API",
    "description": "티엔아카데미 학원 운영 백오피스 — 개발 명세서 v2 기준",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "kim@tnacademy.kr"
          },
          "password": {
            "type": "string",
            "example": "********"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "manager",
              "admin",
              "ceo"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "직함 — 권한과 무관"
          },
          "canAdminPage": {
            "type": "boolean",
            "description": "관리자 백오피스 진입"
          },
          "canCrudAll": {
            "type": "boolean",
            "description": "전 항목 CRUD"
          },
          "canSeeProfit": {
            "type": "boolean",
            "description": "지출 · 총수입 — 대표 전용"
          },
          "canCrudAttendance": {
            "type": "boolean",
            "description": "오늘·이전 스케줄 출결 (D-R35)"
          },
          "canMoney": {
            "type": "boolean"
          },
          "canWage": {
            "type": "boolean"
          },
          "canApprove": {
            "type": "boolean"
          },
          "canHide": {
            "type": "boolean"
          },
          "canGpaPack": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "title",
          "canAdminPage",
          "canCrudAll",
          "canSeeProfit",
          "canCrudAttendance",
          "canMoney",
          "canWage",
          "canApprove",
          "canHide",
          "canGpaPack"
        ]
      },
      "LoginResultDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access 토큰 (15분). Refresh 는 httpOnly 쿠키로 나갑니다"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "RefreshResultDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "KindDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "토큰과 같은 값 — 화면은 이 색을 쓰기만 한다"
          },
          "cap": {
            "type": "number"
          },
          "grp": {
            "type": "string",
            "enum": [
              "lesson",
              "intake",
              "meeting"
            ]
          },
          "rep": {
            "type": "boolean",
            "description": "리포트 대상인가 (D-4)"
          }
        },
        "required": [
          "key",
          "name",
          "color",
          "cap",
          "grp",
          "rep"
        ]
      },
      "SubDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "color"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "branch": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "branch",
          "name"
        ]
      },
      "ZaccDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "meetingId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "StaffBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "manager",
              "admin",
              "ceo"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "표시용 직함 — 권한과 무관하다 (D-R39)"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "StudentBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "nullable": true
          },
          "school": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KindDto"
            }
          },
          "subs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubDto"
            }
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomDto"
            }
          },
          "zaccs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ZaccDto"
            }
          },
          "staff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffBriefDto"
            }
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudentBriefDto"
            }
          }
        },
        "required": [
          "kinds",
          "subs",
          "rooms",
          "zaccs",
          "staff",
          "students"
        ]
      },
      "OccStudentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "nullable": true
          },
          "droppedOnce": {
            "type": "boolean",
            "description": "그날만 빠진 학생인가 (D-R21)"
          }
        },
        "required": [
          "id",
          "name",
          "droppedOnce"
        ]
      },
      "OccurrenceDto": {
        "type": "object",
        "properties": {
          "serId": {
            "type": "number",
            "description": "반복 규칙 id"
          },
          "date": {
            "type": "string",
            "example": "2026-08-28"
          },
          "startMin": {
            "type": "number",
            "description": "자정부터 분"
          },
          "endMin": {
            "type": "number"
          },
          "kindKey": {
            "type": "string"
          },
          "subKey": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "teacherId": {
            "type": "number",
            "nullable": true
          },
          "teacherName": {
            "type": "string",
            "nullable": true
          },
          "roomId": {
            "type": "number",
            "nullable": true
          },
          "roomName": {
            "type": "string",
            "nullable": true
          },
          "zaccId": {
            "type": "number",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "offline",
              "online"
            ]
          },
          "canceled": {
            "type": "boolean"
          },
          "hasException": {
            "type": "boolean",
            "description": "이 회차에 예외가 붙었는가"
          },
          "repState": {
            "type": "string",
            "enum": [
              "na",
              "plan",
              "none",
              "draft",
              "wait",
              "ok",
              "rej"
            ],
            "description": "리포트 상태. 캘린더 블록 색이 이 값에서 나온다 (D-R7 · V26 §2.3)"
          },
          "written": {
            "type": "boolean",
            "description": "리포트를 썼는가 — 정산에 들어가는 조건 하나 (D-R7)"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OccStudentDto"
            }
          }
        },
        "required": [
          "serId",
          "date",
          "startMin",
          "endMin",
          "kindKey",
          "mode",
          "canceled",
          "hasException",
          "repState",
          "written",
          "students"
        ]
      },
      "OccurrenceListDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "example": "2026-08-24"
          },
          "to": {
            "type": "string",
            "example": "2026-08-30"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OccurrenceDto"
            }
          }
        },
        "required": [
          "from",
          "to",
          "items"
        ]
      },
      "ReportStudentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ReportRowDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "serId": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "example": "2026-08-27"
          },
          "startMin": {
            "type": "number"
          },
          "subKey": {
            "type": "string",
            "nullable": true
          },
          "kindKey": {
            "type": "string"
          },
          "teacherId": {
            "type": "number",
            "nullable": true
          },
          "teacherName": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "enum": [
              "na",
              "plan",
              "none",
              "draft",
              "wait",
              "ok",
              "rej"
            ]
          },
          "written": {
            "type": "boolean",
            "description": "썼는가 — 정산 조건 (D-R7)"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportStudentDto"
            }
          },
          "minutesSinceEnd": {
            "type": "number",
            "description": "수업이 끝난 뒤 지난 분. 음수면 아직 안 끝났다"
          },
          "penalty": {
            "type": "number",
            "description": "지금 확정하면 깎이는 금액 (D-R32)"
          }
        },
        "required": [
          "id",
          "serId",
          "date",
          "startMin",
          "kindKey",
          "state",
          "written",
          "students",
          "minutesSinceEnd",
          "penalty"
        ]
      },
      "ReportListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportRowDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "UnwrittenByTeacherDto": {
        "type": "object",
        "properties": {
          "teacherId": {
            "type": "number"
          },
          "teacherName": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "oldestDate": {
            "type": "string",
            "nullable": true,
            "description": "가장 오래된 것"
          },
          "over1h": {
            "type": "number",
            "description": "1시간 넘긴 건수"
          },
          "over4h": {
            "type": "number",
            "description": "4시간 넘긴 건수"
          },
          "penalty": {
            "type": "number",
            "description": "예상 차감 합계"
          }
        },
        "required": [
          "teacherId",
          "teacherName",
          "count",
          "over1h",
          "over4h",
          "penalty"
        ]
      },
      "UnwrittenDto": {
        "type": "object",
        "properties": {
          "byTeacher": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnwrittenByTeacherDto"
            }
          },
          "total": {
            "type": "number"
          },
          "penaltyTotal": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportRowDto"
            }
          }
        },
        "required": [
          "byTeacher",
          "total",
          "penaltyTotal",
          "items"
        ]
      },
      "MoneySummaryDto": {
        "type": "object",
        "properties": {
          "invoiceCount": {
            "type": "number"
          },
          "billed": {
            "type": "number",
            "nullable": true
          },
          "collected": {
            "type": "number",
            "nullable": true
          },
          "outstanding": {
            "type": "number",
            "nullable": true
          },
          "overdueCount": {
            "type": "number"
          },
          "canSeeAmounts": {
            "type": "boolean",
            "description": "금액을 볼 수 있는가 (D-R39 canSeeProfit)"
          }
        },
        "required": [
          "invoiceCount",
          "billed",
          "collected",
          "outstanding",
          "overdueCount",
