        ]
      }
    },
    "/ops": {
      "get": {
        "operationId": "OpsController_all",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsDto"
                }
              }
            }
          }
        },
        "summary": "운영 — 상담 · 컴플레인 · 할 일 · 기획 · 회의 · 마케팅 · 건의",
