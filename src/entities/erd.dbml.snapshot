Ref: MATERIAL_REQUEST_FILE.added_by > STAFF.id [delete: restrict]

// v4.82 → v4.83 (2026-10-09 · TBO-55 BO-11AD-01 권고안 채택) — PAY 증빙 발행 확인·멱등 요청·불변 사건.
//   + PAYMENT_EVIDENCE_POLICY — 배포 적용시각 이전 PAY를 추정 발행하지 않고 월 마감 gate에서 보존한다.
//   + PAYMENT_EVIDENCE — PAY 1:1 current issued/canceled, version, 출력 snapshot, 실제 발행/취소 actor·시각·사유.
//   + PAYMENT_EVIDENCE_REQUEST — 개별 발행/취소 또는 월 일괄 발행의 UUID 멱등 범위.
//   + PAYMENT_EVIDENCE_EVENT — issued/canceled 상태 전이와 결과 version·snapshot을 append-only 보존.
//   + 월 마감 — 양수 PAY 중 current issued가 아닌 건수만 세며 1건 이상이면 PAYMENT_EVIDENCE_UNISSUED.
//   표 +4(117 → 121) · migration 1(1768000000000-payment-evidence) · 운영 미적용.

Table PAYMENT_EVIDENCE_POLICY {
  id smallint [pk, note: '항상 1']
  effective_at timestamptz [not null, default: `now()`]
}

Table PAYMENT_EVIDENCE {
  id bigint [pk, increment]
  pay_id bigint [not null, unique]
  state varchar(12) [not null, note: 'issued | canceled']
  row_version int [not null]
  snapshot jsonb [not null, note: '발행 당시 payId/paidOn/student/content/amount/method']
  issued_by bigint [not null]
  issued_at timestamptz [not null]
  canceled_by bigint
  canceled_at timestamptz
  cancel_reason varchar(200)
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (state, pay_id) [name: 'payment_evidence_state_idx']
  }
}

Table PAYMENT_EVIDENCE_REQUEST {
  request_key uuid [pk]
  actor_id bigint [not null]
  action varchar(12) [not null, note: 'issued | canceled | batch_issued']
  pay_id bigint
  year_month char(7)
  result_count int [not null, default: 0, note: '같은 requestKey 재생 시 반환할 성공 건수']
  skipped_count int [not null, default: 0, note: '일괄 발행에서 이미 발행되어 건너뛴 건수']
  created_at timestamptz [not null, default: `now()`]
}

Table PAYMENT_EVIDENCE_EVENT {
  id bigint [pk, increment]
  payment_evidence_id bigint [not null]
  action varchar(12) [not null, note: 'issued | canceled']
  from_state varchar(12)
  to_state varchar(12) [not null]
  actor_id bigint [not null]
  request_key uuid [not null]
  result_version int [not null]
  snapshot jsonb [not null]
  reason varchar(200)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_evidence_id, result_version) [unique, name: 'payment_evidence_event_version_unique']
    (payment_evidence_id, request_key) [unique, name: 'payment_evidence_event_request_unique']
    (payment_evidence_id, created_at, id) [name: 'payment_evidence_event_evidence_idx']
  }
}

Ref: PAYMENT_EVIDENCE.pay_id > PAY.id [delete: restrict]
