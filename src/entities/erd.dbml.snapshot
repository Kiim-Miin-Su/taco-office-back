//   표 +3(114 → 117) · 새 컬럼 +32 · migration 1(1767900000000-material-request) · 신규/기존 전환·반복·Browser5/5 검증 · 운영 미적용.

Table MATERIAL_REQUEST {
  id bigint [pk, increment]
  teacher_id bigint [not null]
  student_id bigint [not null]
  kind varchar(20) [not null, note: 'book_pdf | worksheet | test_paper | other']
  needed_on date [not null]
  body varchar(2000) [not null]
  state varchar(16) [not null, default: 'received']
  row_version int [not null, default: 1]
  request_key uuid [not null]
  assigned_to bigint
  delivered_by bigint
  reject_reason varchar(500)
  delivered_at timestamptz
  rejected_at timestamptz
  acknowledged_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (teacher_id, request_key) [unique, name: 'material_request_teacher_key_unique']
    (state, needed_on, id) [name: 'material_request_state_needed_idx']
    (teacher_id, created_at, id) [name: 'material_request_teacher_created_idx']
  }
}

Table MATERIAL_REQUEST_EVENT {
  id bigint [pk, increment]
  material_request_id bigint [not null]
  action varchar(20) [not null]
  from_state varchar(16)
  to_state varchar(16) [not null]
  reason varchar(500)
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  payload_sha256 char(64) [not null]
  result_version int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (material_request_id, result_version) [unique, name: 'material_request_event_version_unique']
    (material_request_id, created_at, id) [name: 'material_request_event_request_idx']
  }
}

Table MATERIAL_REQUEST_FILE {
  id bigint [pk, increment]
  material_request_id bigint [not null]
  event_id bigint [not null]
  file_id bigint [not null, unique]
  purpose varchar(12) [not null, note: 'request | delivery']
  added_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (material_request_id, purpose, id) [name: 'material_request_file_request_idx']
  }
}

