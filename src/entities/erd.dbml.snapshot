// v4.83 → v4.84 (2026-10-09 · TBO-55 BO-11AD-03 권고안 채택) — 확정 정산과 실제 지급·취소·재지급 분리.
//   + PAYOUT_DISBURSEMENT — PAYOUT 1:1 current paid/canceled, 확정 금액 snapshot, 실제 지급일·수단·actor·version.
//   + PAYOUT_DISBURSEMENT_REQUEST — 개별 지급/취소 또는 월 일괄 지급의 UUID 멱등 범위와 결과 수.
//   + PAYOUT_DISBURSEMENT_EVENT — paid/canceled 상태 전이, 결과 version·snapshot·실제 지급일을 append-only 보존.
//   + 계좌 번호/reference는 BO-Q9 전까지 저장하지 않고 bank_transfer만 허용한다.
//   표 +3(121 → 124) · migration 1(1768100000000-payout-disbursement) · 운영 미적용.

Table PAYOUT_DISBURSEMENT {
  id bigint [pk, increment]
  payout_id bigint [not null, unique]
  state varchar(12) [not null, note: 'paid | canceled']
  row_version int [not null]
  snapshot jsonb [not null, note: '확정 payoutId/yearMonth/staff/gross/deductions/tax/net snapshot']
  paid_on date [not null]
  method varchar(24) [not null, note: 'bank_transfer']
  paid_by bigint [not null]
  paid_at timestamptz [not null]
  canceled_by bigint
  canceled_at timestamptz
  cancel_reason varchar(200)
  account_id bigint [note: 'BOC-11D-01 지급 당시 보호 계좌 id. 이전 이력은 NULL']
  account_version int [note: '지급 당시 계좌 row_version snapshot']
  account_last4 char(4) [note: '지급 당시 마지막 4자리 snapshot']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (state, payout_id) [name: 'payout_disbursement_state_idx']
  }
}

Table PAYOUT_DISBURSEMENT_REQUEST {
  request_key uuid [pk]
  actor_id bigint [not null]
  action varchar(16) [not null, note: 'paid | canceled | batch_paid']
  payout_id bigint
  year_month char(7)
  paid_on date
  method varchar(24)
  result_count int [not null, default: 0]
  skipped_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table PAYOUT_DISBURSEMENT_EVENT {
  id bigint [pk, increment]
  payout_disbursement_id bigint [not null]
  action varchar(12) [not null, note: 'paid | canceled']
  from_state varchar(12)
  to_state varchar(12) [not null]
  actor_id bigint [not null]
  request_key uuid [not null]
  result_version int [not null]
  snapshot jsonb [not null]
  paid_on date
  method varchar(24)
  reason varchar(200)
  account_id bigint [note: 'paid/canceled 사건이 보존하는 보호 계좌 id']
  account_version int
  account_last4 char(4)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (payout_disbursement_id, result_version) [unique, name: 'payout_disbursement_event_version_unique']
    (payout_disbursement_id, request_key) [unique, name: 'payout_disbursement_event_request_unique']
    (payout_disbursement_id, created_at, id) [name: 'payout_disbursement_event_current_idx']
  }
}

