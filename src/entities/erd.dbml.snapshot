// v4.87 → v4.88 (2026-10-09 · TBO-55 BOC-11D-02 권고안 채택) — 승인 조정의 실제 학생 환불 지급 원장.
//   + STUDENT_REFUND_DISBURSEMENT — 원천 조정별 단일 current와 지급·취소·재지급 상태, 서버 계산 금액, source/account snapshot.
//   + STUDENT_REFUND_DISBURSEMENT_REQUEST/EVENT — UUID 멱등 요청과 actual actor, version, 상태·금액·계좌 불변 이력.
//   + 지급 완료 상태에서는 원천 조정 취소를 차단하고 current receipt/source/account 일치를 지연 trigger로 방어한다.
//   + 표 +3(134 → 137) · migration 1(1768500000000-student-refund-disbursement) · 운영 미적용.

Table STUDENT_REFUND_DISBURSEMENT {
  id bigint [pk, increment]
  invoice_adjustment_id bigint [not null, unique]
  state varchar(12) [not null, note: 'paid | canceled']
  row_version int [not null]
  amount int [not null, note: '현재 승인 전이가 새로 만든 환불 예정액 증가분']
  source_adjustment_version int [not null]
  paid_on date [not null]
  method varchar(24) [not null, note: 'bank_transfer']
  paid_by bigint [not null]
  paid_at timestamptz [not null]
  account_id bigint [not null]
  account_version int [not null]
  account_last4 char(4) [not null]
  canceled_by bigint
  canceled_at timestamptz
  cancel_reason varchar(200)
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (state, invoice_adjustment_id) [name: 'student_refund_disbursement_state_idx']
  }
}

Table STUDENT_REFUND_DISBURSEMENT_REQUEST {
  request_key uuid [pk]
  actor_id bigint [not null]
  action varchar(12) [not null, note: 'paid | canceled']
  invoice_adjustment_id bigint [not null]
  expected_version int [not null]
  payload_sha256 char(64) [not null]
  result_version int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_adjustment_id, created_at) [name: 'student_refund_disbursement_request_source_idx']
  }
}

Table STUDENT_REFUND_DISBURSEMENT_EVENT {
  id bigint [pk, increment]
  student_refund_disbursement_id bigint [not null]
  action varchar(12) [not null, note: 'paid | canceled']
  from_state varchar(12)
  to_state varchar(12) [not null]
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  result_version int [not null]
  amount int [not null]
  source_adjustment_version int [not null]
  paid_on date
  method varchar(24)
  reason varchar(200)
  account_id bigint [not null]
  account_version int [not null]
  account_last4 char(4) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_refund_disbursement_id, result_version) [unique, name: 'student_refund_disbursement_event_version_unique']
    (student_refund_disbursement_id, created_at, id) [name: 'student_refund_disbursement_event_current_idx']
  }
}

