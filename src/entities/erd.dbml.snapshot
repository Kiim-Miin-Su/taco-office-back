Ref: DELINQUENCY_SUSPENSION_EVENT.actor_id > STAFF.id [delete: restrict]

// v4.86 → v4.87 (2026-10-09 · TBO-55 BOC-11D-01 권고안 채택) — 보호 계좌와 강사 지급 snapshot.
//   + PROTECTED_ACCOUNT — student_refund/teacher_payout 대상별 단일 current, AES-256-GCM ciphertext/key version/last4, 삭제 secret purge와 version.
//   + PROTECTED_ACCOUNT_REQUEST/EVENT — UUID 멱등 요청, payload hash, actual actor, 생성·수정·삭제·원문 확인의 append-only 이력.
//   + PAYOUT_DISBURSEMENT/EVENT account id/version/last4 — 지급·취소·재지급 당시 계좌 snapshot. 확정 금액 snapshot은 계속 불변이다.
//   + deferred target/receipt·identity/version-step·hard delete·audit immutable guard. 표 +3(131 → 134) · migration 1(1768400000000-protected-account) · 운영 미적용.

Table PROTECTED_ACCOUNT {
  id bigint [pk, increment]
  purpose varchar(24) [not null, note: 'student_refund | teacher_payout']
  target_id bigint [not null, note: 'purpose에 따라 STU.id 또는 활성 STAFF.id. deferred trigger로 검증']
  state varchar(12) [not null, note: 'active | deleted']
  row_version int [not null]
  ciphertext bytea [note: 'active만 NOT NULL. AES-256-GCM envelope이며 평문 은행·계좌번호·예금주는 별도 컬럼에 저장하지 않는다']
  key_version varchar(32) [note: 'active encryption key version']
  last4 char(4) [note: 'active만 숫자 4자리. 일반 projection의 유일한 계좌 표시값']
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_by bigint [not null]
  updated_at timestamptz [not null, default: `now()`]
  deleted_by bigint
  deleted_at timestamptz
  delete_reason varchar(200)

  indexes {
    (purpose, target_id) [unique, name: 'protected_account_subject_unique']
    (state, purpose, target_id) [name: 'protected_account_state_idx']
  }
}

Table PROTECTED_ACCOUNT_REQUEST {
  request_key uuid [pk]
  account_id bigint [not null]
  actor_id bigint [not null]
  action varchar(12) [not null, note: 'created | updated | deleted | revealed']
  purpose varchar(24) [not null]
  target_id bigint [not null]
  expected_version int [not null]
  payload_sha256 char(64) [not null]
  result_version int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (purpose, target_id, created_at) [name: 'protected_account_request_subject_idx']
  }
}

Table PROTECTED_ACCOUNT_EVENT {
  id bigint [pk, increment]
  account_id bigint [not null]
  action varchar(12) [not null, note: 'created | updated | deleted | revealed']
  from_state varchar(12)
  to_state varchar(12) [not null]
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  result_version int [not null]
  reason varchar(200) [note: '삭제·원문 확인 사유. 계좌 원문은 저장하지 않는다']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, result_version) [unique, name: 'protected_account_state_event_version_unique', note: 'created/updated/deleted action에만 적용하는 partial unique index']
    (account_id, created_at, id) [name: 'protected_account_event_account_idx']
  }
}

