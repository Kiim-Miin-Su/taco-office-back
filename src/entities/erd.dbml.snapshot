// v4.88 → v4.89 (2026-10-09 · TBO-55 BOC-11E 권고안 채택) — 실제 시간 기준 수업료 정책.
//   + HOURLY_RATE_POLICY — 일반·Kinder·그룹 정원·학생/종류 예외 identity, 효력기간, 원/시간 current와 version.
//   + HOURLY_RATE_POLICY_REQUEST/EVENT — UUID 멱등 요청과 생성·교체·종료의 actual actor·snapshot 불변 이력.
//   + identity별 기간 EXCLUDE, current receipt, identity/version-step, hard delete·audit immutable, superseded/retired terminal guard.
//   + 표 +3(137 → 140) · migration 1(1768600000000-hourly-rate-policy) · 운영 미적용.

Table HOURLY_RATE_POLICY {
  id bigint [pk, increment]
  scope varchar(12) [not null, note: 'general | kinder | group | student']
  student_id bigint [note: 'student scope에서만 필수']
  kind_key varchar(16) [note: 'student 예외를 특정 수업 종류에 한정할 때만 사용']
  capacity int [note: 'group scope의 2~100명 정원']
  hourly_amount int [not null, note: '학생 1명 기준 1~100000000원/시간']
  effective_from date [not null]
  effective_to date
  reason varchar(200)
  row_version int [not null, default: 1]
  voided boolean [not null, default: false]
  created_by bigint [not null]
  updated_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (scope, student_id, kind_key, capacity, effective_from, id) [name: 'hourly_rate_policy_lookup_idx']
  }
}

Table HOURLY_RATE_POLICY_REQUEST {
  request_key uuid [pk]
  actor_id bigint [not null]
  action varchar(12) [not null, note: 'created | replaced | retired']
  source_policy_id bigint
  expected_version int [not null]
  payload_sha256 char(64) [not null]
  result_policy_id bigint [not null]
  result_version int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (source_policy_id, created_at) [name: 'hourly_rate_policy_request_source_idx']
  }
}

Table HOURLY_RATE_POLICY_EVENT {
  id bigint [pk, increment]
  policy_id bigint [not null]
  action varchar(12) [not null, note: 'created | superseded | retired']
  actor_id bigint [not null]
  request_key uuid [not null]
  result_version int [not null]
  hourly_amount int [not null]
  effective_from date [not null]
  effective_to date
  reason varchar(200)
  voided boolean [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (policy_id, result_version) [unique, name: 'hourly_rate_policy_event_version_unique']
    (policy_id, created_at, id) [name: 'hourly_rate_policy_event_policy_idx']
  }
}

