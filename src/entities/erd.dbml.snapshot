//
//   ── 세 제약 모두 SER_OCC 에 건다 (TBO-22 에서 실제로 이렇게 만들었다)
//      반복 규칙(SER)은 기간이 열려 있어 걸 대상이 없다. 그래서 회차를 펼쳐 넣고 거기에 건다.
//
//   ALTER TABLE ser_occ ADD CONSTRAINT ser_occ_room_no_overlap
//     EXCLUDE USING gist (room_id WITH =, span WITH &&)
//     WHERE (canceled = false AND room_id IS NOT NULL);
//
//   ALTER TABLE ser_occ ADD CONSTRAINT ser_occ_teacher_no_overlap
//     EXCLUDE USING gist (teacher_id WITH =, span WITH &&)
//     WHERE (canceled = false AND teacher_id IS NOT NULL);
//
//   ALTER TABLE ser_occ ADD CONSTRAINT ser_occ_zoom_no_overlap
//     EXCLUDE USING gist (zacc_id WITH =, span WITH &&)
//     WHERE (canceled = false AND zacc_id IS NOT NULL);
//
//   CREATE UNIQUE INDEX ser_occ_ser_date_uniq ON ser_occ (ser_id, on_date);
//
//      guardResource() 는 사용자에게 미리 알려 주기 위한 **안내**일 뿐이다 — 판정은 DB 가 한다.
//
//   ── 중복 금지 — 재시도·더블클릭이 두 줄을 만들지 않게
//   ALTER TABLE rpt ADD CONSTRAINT rpt_type_date_uniq UNIQUE (rpt_type, on_date);
//   ALTER TABLE rep ADD CONSTRAINT rep_ser_date_uniq  UNIQUE (ser_id, on_date);
//   ALTER TABLE exc ADD CONSTRAINT exc_ser_date_uniq  UNIQUE (ser_id, on_date);
//   ALTER TABLE payout ADD CONSTRAINT payout_staff_month_uniq UNIQUE (staff_id, year_month);
//
//   ── 금액이 음수가 되지 않게
//   ALTER TABLE inv ADD CONSTRAINT inv_paid_le_amount
//     CHECK (paid_amount >= 0 AND paid_amount <= amount);
//   ALTER TABLE payout ADD CONSTRAINT payout_net_nonneg CHECK (net >= 0);
//
//   ── 리포트 JSON 계약 — 1756900000000-report-body-contract.ts
//   ALTER TABLE rep ADD CONSTRAINT rep_body_contract CHECK (
//     body = '{}'::jsonb OR body 가 content · progress · homework 세 문자열 키만 보유
//   );
//
//   ── 리포트 승인·반려 계약 — 1757200000000-report-review-contract.ts
//   ALTER TABLE rep ADD CONSTRAINT rep_review_contract CHECK (
//     (state NOT IN ('wait','ok','rej') OR (written_at IS NOT NULL AND submitted_at IS NOT NULL))
//     AND 승인/반려 상태에 맞는 reviewed_at · reviewer_id · reject_reason exact 조합
//   );
//
//   ── 상태 되돌리기 금지는 제약이 아니라 서비스에서 막는다
//      unpaid → partial → paid, 그리고 → void. 그 외 전이는 409.
// ============================================================================
// TBO-50 C81 §47 독촉: NOTI.request_key nullable + (request_key,to_id) partial unique로 기존 알림을 보존하고 같은 배치의 수신자별 중복을 차단한다. request_teacher_id는 전체(null)/선택 강사 요청 범위를 재시도 때 대조한다. 외부 발송이 아닌 내부 NOTI 원장이다.
