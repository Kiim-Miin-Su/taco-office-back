// version : 4.54 (2026-09-27) — v4.48 까지 2026-09-25 일곱 단계 뒤 v4.49 컴플레인 문의자 관계 · 마무리 시각(CPL.requester · CPL.closed_at · wave6 운영) → v4.50 계정 첫 설정(STAFF 칸 셋 · AUTH_CODE · W8) → v4.51 로그인 아이디 대소문자 무관 유일(STAFF lower(email) 색인 · credentials_changed_at 뜻 넓힘 · W8) → v4.52 인증 코드 용도(AUTH_CODE.purpose · 비밀번호 찾기 N-101 · 하루 한도 N-105) → v4.53 로그인 아이디 분리(STAFF.login_id · 형식 자유 · email NULL 허용 · W10) → v4.54 W11 결정 채택(새 표 일곱 INV_INSTALLMENT · BOOK_SUBJECT · BOOK_CATEGORY · PLAN_PICK · EXEC_AREA_OWNER · Phase B M2 의 PAYOUT_BONUS_RULE · ACCT_PRIVACY · 91표 · 기존 표 칸 스물다섯 · migration 열셋). 9-25 단계: v4.42 상담 진단 점수(LEAD_DIAG · DQ1) → v4.43 학생 보호자·보호자 발송 원장(GUARDIAN·GUARDIAN_SEND · PNOTI note 갱신 · DQ3) → v4.44 알림 제목(NOTI.title · g2 16-1) → v4.45 상담·컨설팅 칸 넷(LEAD.grade · LEAD.reason_kind · CONS_SESS.result · CONS_SESS.next_until · wave3 g3) → v4.46 안내 두 상자(GUIDE.direction · GUIDE.admin_note · wave3 g4) → v4.47 상담 배치안·일정(LEAD_PLAN · LEAD_APPT · LEAD.recheck_on · wave3 g3) → v4.48 공휴일 이름표(HOLIDAY · wave5 스케줄). 변경 이력은 파일 끝 「v4.41 → v4.42」·「v4.42 → v4.43」·「v4.43 → v4.44」·「v4.44 → v4.45」·「v4.45 → v4.46」·「v4.46 → v4.47」·「v4.47 → v4.48」·「v4.48 → v4.49」·「v4.49 → v4.50」·「v4.50 → v4.51」·「v4.51 → v4.52」·「v4.52 → v4.53」·「v4.53 → v4.54」
// canon   : docs/spec/DEV-SPEC.md   (관리자 백오피스 개발 명세서 v2 · 96장 · 구현 실물)
//           docs/spec/V26-SPEC.md   (강사 백오피스 v26 · 고유 영역만)
//           docs/spec/MERGE-2026-08-26.md · MERGE-2026-08-27.md  (어느 쪽을 왜 골랐는지)
// engine  : Neon Postgres · NestJS + TypeORM
// TBO-48B-1 검수: 강사 목록/리포트 공용 소비만 변경. DB 형상·v4.11·64표·11 migrations 변경 없음.
// TBO-48F-2b-1 검수 (2026-09-08): Figma 주간/월간 표본·문서만 변경. DB 형상·v4.11·64표 변경 없음.
// TBO-48F-A 검수 (2026-09-08): Figma 보관 파일 분리·명칭/문서만 변경. DB 형상·v4.11·64표 변경 없음.
// TBO-48F-G 검수 (2026-09-08): 현재 웹/모바일 묶음·페이지 이동만 변경. input/DTO/guard/DB 형상 변경0.
// TBO-48F-2b-2/C/T1 검수 (2026-09-08): Figma 개인표·접이식·강사 홈/캘린더만 변경. input/DTO/guard/DB·v4.11·64표 변경 없음.
// TBO-48F-2b-3 검수 (2026-09-08): Figma §12 원본 상세만 교정. 준비 fact/학생 통계 API는 R3 후속, input/DTO/guard/DB 형상 변경0.
// TBO-48F-I 검수 (2026-09-09): 메뉴 아이콘/선택 상태의 Figma 표현만 변경, input/DTO/guard/DB 형상 변경0.
// TBO-48F-11M-a 검수 (2026-09-09): UNAV cycle+dow만으로 2주 내 같은 요일을 구별할 수 없음. 날짜 식별/소유권/마감 N-20 계약은 후속, 형상 변경0.
// TBO-48F-11M-b1 검수 (2026-09-09): REP.body 3키/본문·검토 CHECK 재사용. REP.lang은 존재하나 언어 쓰기 DTO는 후속, 종료시각은 응답 투영 갭. Figma 기본 작성 화면을 DB 구현 추가로 세지 않으며 형상 변경0.
// TBO-48F-G2 검수 (2026-09-09): Figma 역할별 현행·공용 부품·모바일 모음. 기존 canMoney flag 재사용, input/DTO/guard/DB 형상 변경0.
// ----------------------------------------------------------------------------
// v2.2 → v3.0  — 개발 명세서 어휘로 전면 재편
//   원칙: 명세서의 전역 배열 이름을 테이블 이름으로 **그대로** 쓴다.
//         이름을 바꾸면 마이그레이션과 대조가 둘 다 어려워진다 (명세서 §82).
//
//   버린 표 → 흡수처
//     class · session          → SER + EXC      (반복 규칙 원본 + 그날 예외)
//     class_report             → REP + AUTOREP
//     material(+change_request)→ LIB · ISSUE · VERS · HIST · GPAPACK
//     deposit                  → PAY
//     billing_invoice          → INV
//     audit_log                → LOG
//     change_request           → CHREQ
//     corporate_card_request   → EXPENSE 에 승인 흐름을 얹음
//     instructor               → STAFF (역할 4종 = teacher · manager · admin · ceo — D-R39 확정)
//
//   v4.0 → v4.1 — 2026-08-27 대표 결정 반영
//     N-1 정산 조건    → **작성 기준.** REP.state 를 정산 판정에 쓰지 않는다 (D-R7)
//     N-2 리포트 필드  → **5섹션 고정.** REP.body 는 자동 2섹션을 뺀 입력 3키만 (D-R15·D-R40)
//     N-3 강사 역할    → **role_t 에 존치.** teacher · manager · admin · ceo 4종 (D-R39)
//     N-4 회계 권한    → **지출·총수입만 대표.** 나머지는 매니저 이상 (D-R39)
//     N-5 양식 매핑    → **양식은 하나.** KIND.rep_form 을 쓰지 않는다 (D-R40)
//     N-6 두 제품 연계 → **합치지 않는다.** 명세서대로 새 프로젝트 (D-R38)
//     N-11 권한 저장   → **저장하지 않는다.** role 에서 3줄로 파생 (D-R39)
//     D-13 지각 차감   → **1시간↑ 5,000 · 4시간↑ 10,000** (D-R32)
//     D-14 출결 권한   → **매니저 이상만 CRUD** (D-R35)
//     N-7 보관 정책                            ← 삭제 규칙
// ============================================================================

Project taco_erp {
  database_type: 'PostgreSQL'
  Note: '''
  현재 제품은 관리자 백오피스 한 앱이며 teacher 역할의 읽기 화면도 같은 계약을 쓴다.
  별도 강사 백오피스는 D-R38에 따라 합치지 않으며 이 ERD가 구현 완료를 뜻하지 않는다.

  불변식
    D-1  일정(SER)이 사실이고 나머지는 파생이다.
    D-2  occ(date) = SER 반복 규칙 + EXC. 그날 목록을 만드는 유일한 경로.
    D-3  현황판·대표 보고는 저장하지 않고 매번 계산한다 (서버에서는 집계 API).
    D-4  KIND.rep=true 인 종류만 리포트 대상이다.
    D-5  권한은 role 4종에서 3줄로 파생한다 (D-R39). 컨설팅 공개 범위(CONS.share)만
         독립된 두 번째 층이다 — 권한이 있어도 비공개 컨설팅은 지정된 사람만 본다.
  '''
}

// ─────────────────────────────────────────────────────────────── enums

Enum role_t        { teacher  manager  admin  ceo }
// D-R39 확정 — 역할은 4종이다.
//   teacher 강사   자기 수업 조회 · 리포트 작성 · 출결 읽기 전용
//   manager 매니저 ↑ 여기부터 관리자 페이지가 열리고 전 항목 CRUD
//   admin   관리자 매니저와 같은 권한
//   ceo     대표   + 지출 · 총수입
// 명세서 v2 의 head(교수실장) · adm(상담실장) · coord(코디네이터)는 조직상의 직함이며,
// 권한상으로는 전부 manager 와 같다. 직함은 STAFF.title 에 문자열로 둔다.

Enum kind_grp_t    { lesson  intake  meeting }
Enum class_mode_t  { offline  online }
Enum rep_state_t   { na  plan  none  draft  wait  ok  rej }
// na   리포트 대상 아님 (KIND.rep=false)
// plan 아직 수업 전
// none 미작성 · draft 임시저장 · wait 승인 요청 · ok 승인 · rej 반려
// ⚠️ **정산 판정에 쓰지 않는다** (D-R7). 정산 조건은 「작성했는가」 하나이므로
//    state 는 승인 흐름의 표시일 뿐이고, 급여는 REP 행의 존재만 본다.

Enum guide_state_t { draft  ready  sent  read }
Enum inv_state_t   { draft  sent  unpaid  partial  paid  void }
// D-R37 — 입금 명세서. draft 작성중 · sent 발송 · unpaid 미납 · partial 일부 · paid 완납 · void 취소
// 되돌리기는 없다. 잘못 만들었으면 void 후 새로 만든다.
Enum cons_share_t  { all  money_only  picked  private }
Enum cpl_area_t    { lesson  intake  book  schedule  teacher }
Enum sug_cat_t     { lesson  pay  schedule  etc }
Enum sug_state_t   { open  reviewing  done }
Enum todo_src_t    { meeting  complaint  consulting  plan  manual  lesson  lead }
// lesson — 회차에 걸린 대표 지시 (§12 첫 줄). ser_id·on_date 와 함께 쓴다 (C82-b)
// lead — 등록 뒤 사후 관리 (v4.54 · W11 · N-86). lead_id · care 와 함께 쓴다 (ALTER TYPE … ADD VALUE · migration 1764600000000)
Enum pnoti_audience_t { parent  teacher }
// §43 「매번」이 줄마다 학부모·강사를 따로 체크한다. 학부모 실제 발송은 수신처가 없어 아직 없다 (N-42)

// ─────────────────────────────────────────────────────────────── 상수 코드표
// 명세서 §18 — 관리자 화면에서 추가·색 지정·리포트 대상 여부를 관리한다.
// 자유 문자열이 아니라 표다. 색이 시간표·범례·현황판에서 함께 쓰이기 때문.

Table KIND {
  key         varchar(16) [pk, note: 'class · mock · gpa · study · consult · diagx · consulting · meeting']
  name        varchar(30) [not null]
  color       char(7)     [not null]
  cap         smallint    [not null, note: '정원']
  grp         kind_grp_t  [not null, note: '묶음 분류']
  rep         boolean     [not null, default: false, note: 'true 인 종류만 리포트 대상 (D-4)']
  rep_form    varchar(16) [note: '⚠️ 쓰지 않는다 — 양식은 5칸 하나뿐 (D-R40). 컬럼만 남겨 둔다']
  sort        smallint
  extra       boolean     [not null, default: false, note: 'v4.31 · 추가 수업인가 (C-38) — 시간표 「추가」 배지 · §54 「추가」 칸 · 청구서 줄 「추가 수업 · 과목」. 종류 자체는 §18 이 만든다']
  Note: 'v4.54 · W11 N-30 ① — mock · gpa 정원 1(원문 슬라이드 88 · 옛 기본값 20 · 4 일 때만 migration 1764320000000 이 바꿈 · §18 에서 따로 정한 정원은 덮지 않는다 · 칸 변경 0). 정원은 막는 값이 아니라 알리는 값이라 이미 있는 명단 행은 그대로(초과로만 보인다).'
}

Table SUB {
  key         varchar(20) [pk, note: 'map_read · sat_math · writing … 21종']
  name        varchar(40) [not null]
  color       char(7)     [not null]
  active      boolean     [not null, default: true]
  sort        smallint
}

// ─────────────────────────────────────────────────────────────── 사람

Table STAFF {
  id          bigserial   [pk]
  name        varchar(40) [not null]
  login_id    varchar(120)[not null, note: 'v4.53 · 로그인 아이디 (W10 · 2026-09-26) — 형식 자유 · 띄어쓰기(보이지 않는 글자 포함) 없음 · 1~120자 · 적은 모양 그대로 저장하고 비교는 lower() · lower(login_id) 유일(staff_login_id_lower_key) · 매니저가 만들 때 정한다 · 옛 행은 email 을 옮겼다']
  email       varchar(120)[unique, note: 'v4.53 뜻 바뀜 — 연락 · 인증용(아이디가 아니다) · NULL 허용(만들 때 선택 · 첫 설정에서 본인이 적고 코드로 확인) · 저장 · 비교는 소문자 정규화 · v4.51 lower(email) 유일(staff_email_lower_key · NULL 은 여럿이어도 된다)']
  phone       varchar(20) [note: 'v4.52 뜻 넓힘 — 한국 번호는 숫자만(01012345678) · 해외 번호는 +국가번호…(E.164 · N-103 · 나라 목록은 lib/phone 한 곳 · SENS 국제 문자)']
  role        role_t      [not null, note: 'D-R39 — 권한의 유일한 출처']
  title       varchar(20) [note: '직함 표시용 — 매니저 · 상담실장 · 코디네이터. 권한과 무관 (교수실장 직함은 없음, 2026-09-12)']
  tz          varchar(40) [not null, default: 'Asia/Seoul', note: '관리자 화면은 KST 고정 · 개인 화면에만 적용 (§17)']

  // ── 인증 (D-R41 · TBO-22). 명세서 v2 는 localStorage 라 비밀번호 자리가 없었다.
  password_hash  varchar(72)  [note: 'bcrypt. 길이 60 이지만 알고리즘이 바뀔 자리를 둔다']
  last_login_at  timestamptz
  phone_verified boolean      [not null, default: false, note: 'SENS 인증 완료 여부 (TBO-15)']
  must_change_credentials boolean [not null, default: false, note: 'v4.50 · 첫 설정(v4.53 부터 휴대폰 · 이메일 인증 + 새 비밀번호 — 아이디는 바꾸지 않는다)을 끝내야 한다 — 켜져 있으면 첫 설정 경로 밖의 API 는 403 CREDENTIALS_CHANGE_REQUIRED · 켜는 곳은 관리자 계정 만들기 · 비밀번호 초기화(v4.53 · 매니저가 적은 임시 비밀번호) · 이메일/휴대폰 수정(v4.52 · N-104) · 운영 전환 스크립트뿐']
  email_verified boolean      [not null, default: false, note: 'v4.50 · 이메일 인증 완료 여부 (phone_verified 와 짝)']
  credentials_changed_at timestamptz [note: 'v4.50 · v4.51 뜻 넓힘 — 마지막으로 이 계정의 아이디·비밀번호가 (다시) 정해진 시각(v4.53 부터 첫 설정은 아이디를 바꾸지 않고, 관리자의 아이디 수정은 찍지 않는다 — 세션을 끊지 않는다). 누가 했든 찍는다: 본인 첫 설정 완료 · 본인 비밀번호 찾기(v4.52 · N-101) · 관리자 비밀번호 초기화 · 운영 전환 스크립트. 이보다 먼저 발급된(iat 초 < 이 시각의 초) Access · Refresh 토큰은 401 · 옛 행 NULL = 끊지 않는다 (N-25)']

  // v2 §76 의 권한 5플래그. **평소에는 전부 NULL 이고 role 에서 파생한다** (D-R39).
  // 사람별 예외가 생기는 날에만 값을 넣어 파생 결과를 덮어쓴다.
  can_money    boolean [note: '지출 · 총수입 — NULL 이면 role==ceo']
  can_wage     boolean [note: '강사 시급 · 시수 기준 — NULL 이면 role!=teacher']
  can_approve  boolean [note: '보고 · 기획 · 지출 결재 — NULL 이면 role!=teacher']
  can_hide     boolean [note: '내역 비공개 · 비공개 컨설팅 열람 — NULL 이면 role!=teacher']
  can_gpa_pack boolean [note: '자료 요청 접수 — NULL 이면 role!=teacher']

  hired_on    date        [note: '불가 시간 2주 회차의 기산점']
  active      boolean     [not null, default: true]
  created_at  timestamptz [not null, default: `now()`]

  Note: '''
  v4.53 · 식 색인 staff_login_id_lower_key — UNIQUE ON staff (lower(login_id)). 아이디는 형식 자유 · 대소문자만 다른 두 계정 금지.
    CHECK staff_login_id_shape(1~120자 · [[:space:]] 없음 · NOT VALID — 기존 행은 검사하지 않는다) · 트리거 staff_login_id_default(BEFORE INSERT ·
    login_id 가 없으면 email — 배포 순서 호환). 보이지 않는 글자(폭 없는 공백 등)까지 막는 판정은 서버 한 곳(lib/account-policy.loginIdIssue)이고 CHECK 는 마지막 방어다.
  v4.51 · 식 색인 staff_email_lower_key — UNIQUE ON staff (lower(email)). 아이디=이메일(v4.53 부터 아이디는 login_id · 이메일은 연락 · 인증용) · 대소문자만 다른 두 계정 금지.
    식 색인은 indexes 블록 대신 여기 적는다(scripts/dbml-parse.py 가 괄호 든 식을 칸으로 읽는다) · 엔티티는 synchronize:false 로 이름만 안다.
    기존 중복이 있으면 마이그레이션 1763700000000 이 멈춘다(보정 0 · N-25).
  명세서 시드 16명. 대표 3 · 교수실장 1 · 상담실장 1 · 코디 3 + 강사.
  실측 가능/잠김 — 대표 14/0 · 교수실장 2/12 · 상담실장 0/14 · 코디네이터 0/14 (D-R28).
  ⚠️ 이 실측은 v2 화면의 **표시**이고, 판정은 D-R39 3줄이다.
     canAdminPage = role != teacher · canCrudAll = role != teacher · canSeeProfit = role == ceo
  대표 전용 12가지 중 **지출 · 총수입만** 실제로 대표 전용이고, 나머지는 매니저 이상이 본다.
  '''
}

Table AUTH_CODE {
  id            bigserial    [pk]
  staff_id      bigint       [not null, ref: > STAFF.id, note: 'ON DELETE CASCADE — 계정이 사라지면 코드도 뜻이 없다']
  channel       varchar(8)   [not null, note: 'email | sms (auth_code_channel_words CHECK) — 보내는 길은 기존 Sender 한 곳(SMTP · Naver SENS · DQ3)']
  purpose       varchar(16)  [not null, default: 'onboarding', note: 'v4.52 · onboarding | password_reset (auth_code_purpose_words CHECK · N-101) — 확인이 용도를 함께 본다(첫 설정 코드로 비밀번호를 바꾸지 못하게) · 코드 해시 메시지에도 용도가 든다 · 발급 한도는 용도와 무관하게 계정 · 채널마다 센다']
  target_hash   varchar(64)  [not null, note: '받는 곳(정규화)의 HMAC — 원문을 저장하지 않는다']
  target_masked varchar(160) [not null, note: '사람이 읽는 가린 받는 곳 — maskEmail · 휴대폰 가운데 가림']
  code_hash     varchar(64)  [not null, note: '6자리 코드의 HMAC(서버 비밀) — 원문을 저장하지 않는다']
  expires_at    timestamptz  [not null, note: '보낸 뒤 10분 (auth_code_expiry_after_create CHECK)']
  attempts      int          [not null, default: 0, note: '틀린 횟수 — 다섯 번이면 그 코드는 끝난다 (auth_code_attempts_range CHECK >= 0)']
  consumed_at   timestamptz  [note: '맞게 쓴 시각 — 한 번 쓴 코드는 다시 못 쓴다']
  created_at    timestamptz  [not null, default: `now()`]

  indexes { (staff_id, channel, created_at) [name: 'auth_code_staff_channel_idx'] }
  Note: '''
  v4.50 · W8 첫 설정 인증 코드. v4.52 · 비밀번호 찾기(N-101)도 같은 원장을 쓴다(purpose 로 가른다).
  쓰는 곳은 POST /auth/onboarding/codes · /auth/onboarding/complete · /auth/password-reset/codes · /auth/password-reset/complete 넷뿐(원장 규칙은 src/auth/auth-code.ts 한 곳).
  발급 한도 — 60초 간격 · 한 시간 5번 · 하루(24시간) 10번(N-105) · 계정 · 채널마다. 해시 키는 운영에서 AUTH_CODE_SECRET 만(N-105 · 없으면 503).
  시드 --reset 이 비운다(SEEDED_TABLES). 운영 전환 스크립트도 비운다.
  '''
}

Table STU {
  id          bigserial   [pk]
  name        varchar(40) [not null]
  grade       varchar(10)
  school      varchar(60)
  target_exam varchar(40)
  started_on  date
  guidance    varchar(20) [note: '지도 강도']
  lang        varchar(20) [note: '수업 언어']
  gender      varchar(6)  [note: 'v4.54 · W11 N-83 선택 칸 — female | male (stu_gender_words CHECK · NULL 허용). 옛 학생 NULL — 추정 보정 0 (N-25). 관리자 §10 아바타에만 쓰고 학부모 · 외부 출력(리포트 · 안내 · 보호자 발송 · PNG)에 싣지 않는다. 등록 확정이 새 학생을 만들 때만 받는다 · 낱말은 GET /meta genders · migration 1764110000000']
  created_at  timestamptz [not null, default: `now()`]
  Note: '시드 19명. 코디네이터와 공유. 포인트·청구는 강사에게 노출하지 않는다.'
}

Table LEAD {
  id          bigserial   [pk]
  student_id  bigint      [ref: > STU.id, note: '등록되면 채워진다']
  name        varchar(40) [not null]
  school      varchar(60)
  owner_id    bigint      [ref: > STAFF.id]
  stage       varchar(16) [not null, note: '1차 · 2차대기 · 2차 · 보류 · 등록 · 실패']
  fail_from   varchar(16) [note: 'N-25 — 실패 당시 이전 단계 명시값(전이 시 라이브 기록). 레거시 NULL=미분류 — stop_at 추정 이관 금지']
  stop_at     varchar(16) [note: '옛 중단 지점(before_book · before_first · after_first · after_second) — v4.54 · W11 N-87 뒤로 읽기 전용 기록. 새로 쓰지 않고 되살리기 · 등록 확정도 지우지 않는다(A′ 후속) · §24 분류는 fail_from → 도달 기록(LEAD_STAGE_LOG) 역순 · 대응표 이관 없음(N-25)']
  reason      text
  source      varchar(16) [note: 'v4.34 · kakao | phone | blog | instagram | referral | walkin — 컷 §23 유입 경로 여섯 (lead_source_words CHECK · NULL 허용). 옛 행은 NULL — 추정 보정 0 (N-25 · N-44). 낱말은 lib/intake-words 한 곳']
  reason_kind varchar(16) [note: 'v4.45 · unreachable | other_academy | schedule | cost | timing — §24 실패 사유 분류 다섯 (lead_reason_kind_words CHECK · NULL 허용 · 24-05). reason(자유 글)은 설명 칸으로 남는다. 옛 실패 건 NULL — 사유 글에서 추정하지 않는다(N-25). 낱말은 lib/intake-words 한 곳']
  grade       varchar(10) [note: 'v4.45 · §23 카드의 학년 칩 (23-10). STU.grade 와 같은 폭의 자유 글 — 표기 규약을 서버가 바꾸지 않는다 · 옛 건 NULL · 등록 확정 창이 학생 학년의 기본값으로 채운다']
  recheck_on  date        [note: 'v4.47 · 보류 재확인 날짜 (23-16). NULL 이면 보류에 들어온 날(LEAD_STAGE_LOG) + 2일(슬라이드 23 「D+2에 수락 여부 확인」) — LeadDto.recheckOn 은 그 유효값이다. POST /ops/leads/{id}/hold/extend(「연장 +2일」)가 유효값 + 2일을 적고, 단계가 바뀌면(단계 이동·되살리기) 비운다']
  first_lesson_on date    [note: 'v4.54 · W11 N-86 — 등록 확정 때 잡은 첫 실제 수업일(시작일 이후 · 휴강 · 그날 빠짐 · 휴원 아닌 첫 회차). 해피콜 +7일 · 월간 「같은 날」의 기준. 옛 건 NULL(보정 0 · N-25) · migration 1764600000000']
  created_at  timestamptz [not null, default: `now()`]
  Note: '''
  시드 18건. 어느 단계에서 멈췄는지로 분류한다 (§24).
  C90 (N-44 · N-45): 유입은 POST /ops/leads(언제나 stage=first · LEAD_STAGE_LOG first) · 단계 이동은 PATCH /ops/leads/{id}/stage(전이표 LEAD_NEXT_STAGES · 같은 트랜잭션에 LEAD_STAGE_LOG) ·
  사후 관리는 LEAD_TOUCH. 「소개」가 누구 소개인지는 칸이 아니라 LEAD_TOUCH 의 한 줄이다(N-44 결정문).
  48F-3a3b-B1: id/student_id/name/school/owner_id/stage/stop_at/reason/created_at 9컬럼을 기존 entity/init migration과 대조.
  조회 LeadDto는 studentId/ownerId를 포함하고 ownerName(STAFF join)/ageDays(KST 접수 경과일)를 파생한다.
  48F-3a3c-C1: FQ는 name/school/ownerName/reason의 로컬 검색이다. 검색어/선택 상태는 비영속이며 컬럼 추가0.
  fail.from/at{} 대응은 N-25 채택(§4-17 · C35)으로 종결 — from=fail_from(전이 순간 서버 라이브 기록),
  at 역순=LEAD_STAGE_LOG(id 단조) 역순 판정(failed 제외). 레거시 stop_at 추정 이관 없음 — 미분류 보존.
  created_at은 실패일이 아니다. v4.45(wave3): 실패일은 LEAD_STAGE_LOG 의 마지막 failed 줄(LeadDto.failedAt · 24-04), 재연락 대기/완료는 그 뒤 LEAD_TOUCH 가 있는가(24-06),
  단계 기한 띠는 지금 단계에 들어온 날(LEAD_STAGE_LOG 마지막 줄 · 1차는 created_at) + 슬라이드 23 SLA(1차 2 · 2차 대기 7 · 2차 상담 1 · 보류 2)로 서버가 파생한다(23-12 · 칸 추가 0).
  등록 실패 건도 되살리기 없이 등록 확정한다(24-07) — 이력은 LEAD_STAGE_LOG(failed → enrolled)와 LOG before 에 남고 stop_at·fail_from 은 되살리기처럼 비운다. 당시 배치안은 v4.47 LEAD_PLAN 이다(23-16 · 24-07).
  위 student_id/owner_id ref는 목표 FK다. init migration에는 실제 FK가 없으며 이번에 운영 DB 무결성을 검증하거나 적용하지 않았다.
  v4.54 · W11(N-86 · N-87): 등록 확정 트랜잭션이 사후 관리 할 일(TODO src=lead · 해피콜 · 첫 월간)을 상담 담당에게 만든다(ops/lead-care · first_lesson_on 기준).
  등록 확정은 이제 stop_at 을 건드리지 않고 fail_from 만 되살리기처럼 비운다(A′ 후속 1) — 위 24-07 문장의 「stop_at·fail_from 은 … 비운다」는 이 줄로 바뀐다.
  '''
}

Table LEAD_STAGE_LOG {
  id      bigserial   [pk]
  lead_id bigint      [not null, ref: > LEAD.id]
  stage   varchar(16) [not null]
  by_id   bigint      [ref: > STAFF.id]
  at      timestamptz [not null, default: `now()`]

  indexes { (lead_id, id) }
  Note: '''
  상담 단계 도달 기록 — append-only (N-25 채택 · v2 §24). 순서 보장은 id 단조.
  «마지막 단계» 판정: fail_from 명시값 → 이 로그 역순(failed 제외) → 미분류.
  이력 없는 레거시 건은 미분류로 보존한다 — 추정 이관을 하지 않는다.
  C90 (N-45): 실패·되살림·등록(C91)에 더해 유입(first)과 단계 이동이 여기 남는다 — 이름대로 도달 기록이 됐다.
  §71 퍼널은 「이 달 들어온 건 중 그 단계의 기록이 있거나 지금 그 단계인 건」으로 세고 min(at) 를 「도달 기록 시작일」로 화면에 말한다(옛 건 보정 0).
  '''
}

Table LEAD_TOUCH {
  id      bigserial   [pk]
  lead_id bigint      [not null, ref: > LEAD.id]
  kind    varchar(16) [not null, note: 'call | kakao | sms | visit | book(상담 예약) | noshow(예약 불참) | memo — lead_touch_kind_words CHECK · 낱말은 lib/intake-words']
  note    text        [not null, note: '한 줄 — lead_touch_note_present CHECK(빈 줄 금지)']
  next_on date        [note: '다음 접촉·상담 예정일 — book 이면 상담 날짜. 「상담 오늘·지남」·「사후 관리 임박·밀림」은 마지막 접촉의 이 칸으로 서버가 센다']
  by_id   bigint      [ref: > STAFF.id]
  at      timestamptz [not null, default: `now()`]

  indexes { (lead_id, id) }
  Note: '''
  v4.34 · C90 · N-44 결정문 — 상담 사후 관리 접촉 원장(누가 · 언제 · 어떻게 · 한 줄 · 다음은 언제) append-only.
  단계 전이 로그(LEAD_STAGE_LOG)에 섞지 않는다 — 두 뜻이 한 표에서 갈린다. 끝난 건(등록 · 실패)에도 적는다(해피콜 · 재연락).
  「+ 신규 문의」의 첫 접촉 한 줄은 유입 경로에서 「어떻게」를 정한다(카카오채널→카카오톡 · 전화→전화 · 워크인→방문 · 그 밖→메모).
  시드는 넣지 않는다 — QA 가 만든 행은 seed --reset 이 비운다.
  '''
}

Table LEAD_DIAG {
  id         bigserial   [pk]
  lead_id    bigint      [not null, ref: > LEAD.id, note: '상담 건 — 등록되면 LEAD.student_id 를 따라 그 학생의 진단으로 읽힌다(칸을 새로 채우지 않는다)']
  english    integer     [note: '영어 점수 — 0 이상(lead_diag_score_nonneg). 만점·경계는 주어지지 않아 위 끝을 두지 않는다(DQ1)']
  math       integer     [note: '수학 점수 — 0 이상']
  interview  integer     [note: '인터뷰 점수 — 0 이상']
  taken_on   date        [note: '진단고사를 본 날 — 모르면 NULL']
  level      varchar(12) [note: 'foundation | practice | master — 담당자가 고른 값(lead_diag_level_words CHECK · NULL = 아직 고르지 않음). 낱말은 lib/lead-diag-words 한 곳. 점수에서 계산하지 않는다']
  book_id    bigint      [ref: > LIB.id, note: '담당자가 고른 교재 — 등록 확정 때 교재 키를 안 보낸 첫 줄의 기본 교재가 된다(null 은 덮지 않는다)']
  note       text        [note: '메모 — LOG 에는 싣지 않는다(연락처가 섞일 수 있다)']
  created_by bigint      [not null, ref: > STAFF.id]
  created_at timestamptz [not null, default: `now()`]

  indexes { (lead_id, id) }
  Note: '''
  v4.42 · DQ1 대표 답변(2026-09-25) 「점수만 저장 + 담당자가 선택」 · N-53 · v2 §23 「진단고사 점수 입력」 · 테스트 시나리오 A-04.
  append-only — 가장 최근 줄이 지금 값이다(GET /ops LeadDto.latestDiag · GET /ops/leads/{id}/diag 이력). POST /ops/leads/{id}/diag 가 LOG(LEAD diag)와 한 트랜잭션.
  lead_diag_not_empty — 점수 셋·레벨·교재 중 하나는 있어야 한다. A-04/A-05 의 「자동 판정·자동 배치」는 의도적 제외다(부분 완료가 아니라 채택된 범위).
  DIAG(강사 서술형 진단 리포트 · student_id NOT NULL)와 다른 표다 — 값을 옮겨 적지 않는다. 시드 3행(2차 상담·보류 건 · 레벨·교재는 담당자가 고른 표본 값).
  '''
}

Table LEAD_PLAN {
  id         bigserial   [pk]
  lead_id    bigint      [not null, ref: > LEAD.id]
  seq        smallint    [not null, note: '줄 차례 1~8 (lead_plan_seq_range) · (lead_id, seq) 유니크 lead_plan_lead_seq']
  kind_key   varchar(16) [not null, ref: > KIND.key]
  sub_key    varchar(20) [ref: > SUB.key, note: '과목 — 비우면 종류 이름으로 부른다']
  per_week   smallint    [not null, note: '주 N회 1~7 (lead_plan_per_week_range). 요일·시각은 등록 확정 창에서 잡는다']
  teacher_id bigint      [ref: > STAFF.id, note: '강사 — 비워도 된다(초안)']
  created_by bigint      [not null, ref: > STAFF.id]
  created_at timestamptz [not null, default: `now()`, note: '적은 때 — 「당시」 단가표(RATE)를 고르는 기준일(KST)']

  Note: '''
  v4.47 · wave3 g3 23-16 · 24-07 — 상담 배치안 초안 줄. 원본 §23 카드 「SAT Reading 주2 · Rebecca」 · §24 「당시 배치안」.
  PUT /ops/leads/{id}/plan 이 한 건의 줄을 통째로 바꿔 적는다(LOG LEAD plan before/after · 깔때기 안 넷에서만 · 등록·실패 건은 409 LEAD_PLAN_LOCKED).
  단가 칸이 없다 — 단가표(RATE)가 정본이라 두 곳이면 갈린다(D-R22). LeadPlanLineDto.unitPrice 는 적은 날의 RATE(1인 구간 · 과목 단가 우선)를 읽기 때 붙이고,
  금액을 볼 수 있는 사람(canMoney)에게만 내려간다(D-R39). 월 합계는 산식 결정 전이라 내리지 않는다.
  「+ 등록 확정」 창이 이 줄로 배치안 줄(종류 · 과목 · 강사)을 채운다 — 요일·시각은 사람이 잡는다. 시드 5행.
  '''
}

Table LEAD_APPT {
  id         bigserial   [pk]
  lead_id    bigint      [not null, ref: > LEAD.id]
  kind       varchar(8)  [not null, note: 'diag(진단고사) | second(2차 상담) — lead_appt_kind_words · (lead_id, kind) 유니크 lead_appt_lead_kind']
  on_date    date        [not null]
  start_min  smallint    [not null, note: 'lead_appt_time_range — 0 ≤ start < end ≤ 1440']
  end_min    smallint    [not null]
  mode       varchar(8)  [not null, default: 'offline', note: 'offline | online (lead_appt_mode_words) · 온라인이면 room_id NULL (lead_appt_online_no_room)']
  room_id    bigint      [ref: > ROOM.id]
  ser_id     bigint      [ref: > SER.id, note: '시간표 회차 — NULL 이면 「미생성」. 시간표에서 지우면 연결만 풀린다(ON DELETE SET NULL)']
  created_by bigint      [not null, ref: > STAFF.id]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
  v4.47 · wave3 g3 23-15 — 원본 §23 2차 대기 카드의 「진단 08-24 10:00 · 본원 [미생성]」「2차 08-26 14:30 · 본원 [미생성]」.
  PUT /ops/leads/{id}/appts 가 종류마다 한 줄을 적는다(이미 시간표에 만든 줄은 409 LEAD_APPT_SCHEDULED — 시간표에서 옮긴다).
  POST /ops/leads/{id}/appts/schedule(「스케줄에 N건 만들기」)가 기존 시간표 쓰기(ScheduleWriteService.create · ONCE)로 회차를 만들고 ser_id 로 잇는다
  (진단 = KIND diagx · SUB diag, 2차 = KIND consult · SUB intake · 강사 자리 = 상담 담당 · 겹침은 SER_OCC EXCLUDE 가 막는다 → 409 RESOURCE_CONFLICT).
  이은 뒤의 날짜·시각·강의실은 시간표(SER_OCC)가 정본이다 — 카드는 그 회차를 읽는다. 2차 대기 카드의 기한 띠는 2차 일정이 있으면 「2차 상담 날짜 시각」이다.
  시드 3행(2차 대기 두 건 · 전부 미생성).
  '''
}

Table ENR {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  kind_key    varchar(16) [not null, ref: > KIND.key]
  sub_key     varchar(20) [ref: > SUB.key]
  sessions    smallint    [note: '회차']
  started_on  date
  ended_on    date
  Note: '시드 16건. 청구서(INV) 자동 생성의 근거.'
}

Table TZG {
  id          bigserial   [pk]
  name        varchar(40) [not null]
  tz          varchar(40) [not null]
}

Table HOLIDAY {
  on_date     date        [not null, note: 'v4.48 · 공휴일 날짜(KST 달력 날짜)']
  name        varchar(40) [not null, note: 'v4.48 · 칩에 그대로 적는 이름 — 대체공휴일은 「광복절 대체」처럼 원문 컷의 낱말 (holiday_name_present CHECK: 빈칸 금지)']

  indexes { (on_date, name) [pk] }
  Note: '''
  원문 §09 월간 칸 「광복절」·「광복절 대체」 칩 · §10 요일 머리 (g1 §09 #2 · §10 #8).
  화면이 정적 공휴일 표를 들면 업무 데이터 사본이 되므로 서버 표로 둔다. 한 날에 이름이 둘일 수 있어 키는 (날짜, 이름).
  표시 전용 — 일정을 막거나 회차를 지우지 않는다. 2026 법정 공휴일은 마이그레이션 1763100000000 이 함께 넣는다(참고 자료 · 시드 --reset 대상 아님).
  '''
}

// ─────────────────────────────────────────────────────────────── 자원

Table ROOM {
  id          bigserial   [pk]
  branch      varchar(20) [not null, note: '강남 · 송도 · 제주']
  name        varchar(40) [not null]
  capacity    smallint
  active      boolean     [not null, default: true]
  indexes { (branch, name) [unique] }
}

Table ZACC {
  id             bigserial   [pk]
  label          varchar(20) [not null, unique]
  login_email    varchar(120)[not null]
  login_secret   bytea       [not null, note: 'AES-256 · 평문 금지 · 키는 별도 저장소']
  join_url       text        [not null, note: '학생용 참가 링크 — 로그인 정보와 절대 같은 자리에 두지 않는다']
  meeting_id     varchar(30)
  meeting_pw_enc bytea
  active         boolean     [not null, default: true]
  Note: '시드 6개. 계정 하나 = 회의 하나. 온라인 수업 100건 중 98건 배정 (§21).'
}

Table ZASSIGN {
  id          bigserial   [pk]
  ser_id      bigint      [ref: > SER.id, note: 'ON DELETE CASCADE — 규칙이 사라지면 배정도 따라간다 (v4.23)']
  exc_id      bigint      [ref: > EXC.id, note: 'ON DELETE CASCADE — 회차 예외가 사라지면 배정도 따라간다 (v4.23)']
  zacc_id     bigint      [not null, ref: > ZACC.id, note: 'ON DELETE RESTRICT — 쓰이는 계정은 못 지운다. 그만 쓰는 길은 ZACC.active=false (v4.23)']
  fixed       boolean     [not null, default: true, note: '고정 배정 vs 변동']
  Note: '''같은 시간에 한 계정이 두 수업에 배정되면 겹침으로 표시 (D-R3).
  물리 제약 (v4.23 · C84-c) — DBML 이 선언만 하고 표에는 없던 것들:
    CHECK  zassign_target_one   (ser_id IS NULL) <> (exc_id IS NULL)  NOT VALID
    UNIQUE zassign_ser_once     (ser_id) WHERE ser_id IS NOT NULL
    UNIQUE zassign_exc_once     (exc_id) WHERE exc_id IS NOT NULL
  정본은 이 표이고 SER_OCC.zacc_id 는 그 투영이다 — 그 칸이 비면 겹침 EXCLUDE 가 줌 계정을 지키지 못한다.'''
}

Table ZLOG {
  id          bigserial   [pk]
  zacc_id     bigint      [not null, ref: > ZACC.id]
  actor_id    bigint      [not null, ref: > STAFF.id]
  action      varchar(20) [not null, note: 'view_secret | rotate | assign']
  at          timestamptz [not null, default: `now()`]
  Note: '복호화 열람은 반드시 남긴다.'
}

// ─────────────────────────────────────────────────────────────── 일정

Table SER {
  id            bigserial   [pk]
  kind_key      varchar(16) [not null, ref: > KIND.key]
  sub_key       varchar(20) [ref: > SUB.key]
  teacher_id    bigint      [ref: > STAFF.id]
  room_id       bigint      [ref: > ROOM.id]
  mode          class_mode_t[not null]
  start_min     smallint    [not null, note: '0~1439 분 단위 정수']
  end_min       smallint    [not null]
  rrule         varchar(80) [not null, note: '반복 규칙. ONCE | DAILY[/n] | WEEKLY:MO,WE[/n]. 새 API 입력은 parseRuleInput의 전체 문법·양의 안전한 정수 간격 검증 후 formatRule로 정규화한다. 과거 읽기 parser와 직접 DB 쓰기 CHECK는 별도이며 무결성 완료를 뜻하지 않는다']
  from_date     date        [not null]
  to_date       date
  title         varchar(80)
  created_at    timestamptz [not null, default: `now()`]

  indexes { (from_date, to_date) (teacher_id) (room_id) }
  Note: '''
  일정 **원본**. 시드 35건. 정기 수업이 대부분이라 회차마다 행을 만들지 않는다.
  ser_time_check: start 0~1439/end 1~1440/길이10~480분. 이력 보존 취소를 위해 to_date<from_date를 금지하지 않는다.
  그날 목록은 occ(date) = SER 반복 규칙 + EXC 로 만든다 (D-2).
  겹치면 저장이 막힌다 (D-R1).
  '''
}

Table SER_STU {
  ser_id      bigint [not null, ref: > SER.id]
  student_id  bigint [not null, ref: > STU.id]
  from_date   date   [note: 'v4.30 · 이 날부터 명단에 있다 — NULL 이면 처음부터. 등록 확정(C91)이 적을 자리']
  to_date     date   [note: 'v4.30 · 이 날까지 명단에 있다 — NULL 이면 끝까지. 수강 종료(C94-c)가 적는다 · ser_stu_range CHECK']
  indexes { (ser_id, student_id) [pk] }
  Note: '''
  그룹 수업의 참여 학생. 인원이 늘면 1인 단가가 내려가고 총액은 오른다 (D-R10).
  v4.30 · C94-c — 테스트 시나리오 H-80 「중도 환불」 · N-136 「학생이 갑자기 그만둠」 · N-50 ①.
  행을 지우면(「아주 빼기」 · D-R21) 지난 회차의 명단까지 사라져 이미 청구한 달의 셈이 바뀐다 — 수강 종료는 to_date 를 적는다.
  그 날짜에 유효한가는 lib/sql.serStuOn 한 조각: 시간표 명단·§54·청구서(invoice-lines)·단가 구간의 인원·리포트 발송 대상이 같은 판정을 읽는다.
  종료한 학생을 같은 규칙에 다시 넣을 수 없다(ROSTER_ENDED) — 새 규칙으로 등록한다. 기존 행 보정 0.
  '''
}

Table EXC {
  id          bigserial   [pk]
  ser_id      bigint      [not null, ref: > SER.id]
  on_date     date        [not null, note: '원래 날짜']
  canceled    boolean     [not null, default: false, note: '휴강']
  new_date    date        [note: '옮긴 경우']
  start_min   smallint
  end_min     smallint
  teacher_set boolean     [not null, default: false, note: 'false=SER 강사 상속, true=teacher_id(null 포함) 사용']
  teacher_id  bigint      [ref: > STAFF.id, note: 'teacher_set=true일 때 강사 교체 또는 null=미지정']
  room_set    boolean     [not null, default: false, note: 'false=SER 강의실 상속, true=room_id(null 포함) 사용']
  room_id     bigint      [ref: > ROOM.id, note: 'room_set=true일 때 강의실 교체 또는 null=미지정']
  reason      text        [note: '휴강 메모 — C92 부터 휴강 창의 「메모」가 여기 적힌다']
  mode        varchar(8)  [note: 'v4.54 · W11 N-56 그 회차 하나의 방식 — offline | online (exc_mode_words CHECK) · NULL 이면 규칙(SER.mode)을 따른다 · 규칙과 같은 값은 적지 않는다. 온라인이면 room_set=true · room_id=NULL 이고 줌은 EXC 대상 ZASSIGN · 현장이면 그 회차 줌 배정을 푼다. 읽는 쪽은 lib/sql.effectiveModeOf 한 조각']
  memo        text        [note: 'v4.54 · W11 N-57 회차 메모 한 줄(이번 회차만) — exc_memo_len CHECK(공백만 금지 · 200자) · 블록 「노트」 배지 · §08 회차 메모 줄. 휴강 메모(reason)와 섞지 않는다 · 메모만 남은 예외도 효과로 센다(정리 규칙이 지우지 않는다)']
  cancel_kind  varchar(16) [note: 'teacher_absent | student_absent | academy | holiday | other — 휴강 사유 (v4.26 · C92)']
  cancel_treat varchar(8)  [note: 'carry | deduct | makeup — 이월 · 차감 · 보강 이관 (v4.26 · C92). null = 옛 휴강 = 이월로 읽는다']
  makeup_ser_id bigint     [ref: > SER.id, note: '보강 이관이면 보강 회차(ONCE 규칙)의 SER — ON DELETE SET NULL · exc_makeup_link CHECK: 처리가 makeup 일 때만 (v4.27 · C92-b)']
  by_id       bigint      [ref: > STAFF.id]
  at          timestamptz [not null, default: `now()`]

  indexes { (ser_id, on_date) [unique] }
  Note: '''
  그날만 다른 것. 시드 7건 (강사 교체 실측 시 7→19).
  exc_cancel_policy (v4.26 · C92 · NOT VALID): 사유·처리는 낱말 안에서만, 처리는 취소 회차에만(사유와 짝),
  **차감은 학생 결석에만** — 학원 사정·공휴일·강사 결강은 이월이고 강사료에도 안 든다 (테스트 시나리오 C-30~C-34).
  cancel_treat 가 null 인 옛 휴강은 이월로 센다 — 기존 행 보정 0 (N-25). 판정은 lib/rules.cancelPolicyIssue 한 곳.
  보강 이관(v4.27 · C-34)은 같은 리듀스에서 ONCE 규칙 하나를 새로 만들고 makeup_ser_id 가 그것을 가리킨다 —
  회계는 원래 회차를 세지 않고(이월도 아니다) 보강 회차를 센다: 「원래 1 + 보강 1 = 2 가 아니라 1」.
  nullable FK만으로는 상속과 명시적 미지정을 구분할 수 없어 *_set 플래그를 함께 쓴다 (TBO-44D-2).
  CHECK: teacher_set OR teacher_id IS NULL · room_set OR room_id IS NULL.
  exc_time_check: 명시 start/end 범위 및 양쪽 명시 시 길이10~480분. null 상속 결과는 API 최종 상태 검사, DB 직접 부모 변경 보장은 별도.
  강사를 바꾸면 EXC + GUIDE + PNOTI + ISSUE 가 동시에 움직인다.
  그날 명단은 occRaw() 가 EXC_STU_OUT 을 걸러 만든다 (D-R21).
  v4.54 · W11(migration 1764100000000): exc_mode_words (mode IS NULL OR mode IN ('offline','online')) · exc_memo_len (memo IS NULL OR (char_length(btrim(memo)) > 0 AND char_length(memo) <= 200)) — 새 칸이라 옛 행 보정 0 (N-25).
  메모만 보내는 PATCH 는 범위와 무관하게 그 회차 하나(this)다 — 규칙을 가르지 않고 휴강을 풀지 않는다.
  W11 대조(DB 정본 · 기록만): (ser_id, on_date) 유니크가 DB 에 둘이다 — 제약 exc_ser_date_uniq 와 색인 exc_ser_id_on_date_uniq(같은 열). 이번 물결이 만든 것이 아니고 지우지 않았다.
  '''
}

Table EXC_STU_OUT {
  exc_id      bigint [not null, ref: > EXC.id]
  student_id  bigint [not null, ref: > STU.id]
  indexes { (exc_id, student_id) [pk] }
  Note: '''
  v2 §79·§80 — 「이 회차만 빼기」. 소스의 EXC[id|date].stuOut 이다.
  「아주 빼기」는 여기가 아니라 SER_STU 에서 지운다 (D-R21).
  학생에 「향후」 범위를 줄지는 결정 안건 N-15.
  '''
}

Table MONTH_CLOSE {
  id            bigserial   [pk]
  year_month    text        [not null, note: 'YYYY-MM · month_close_shape CHECK']
  closed_by     bigint      [not null, ref: > STAFF.id, note: '마감한 대표']
  closed_at     timestamptz [not null, default: `now()`]
  reopened_by   bigint      [ref: > STAFF.id, note: '해제한 대표 — reopened_at·reopen_reason 과 짝 (month_close_reopen_pair CHECK)']
  reopened_at   timestamptz
  reopen_reason text        [note: '해제 사유 — 필수. 흔적 없이 고치지 않는다 (N-140)']
  indexes { (year_month) [unique, note: 'month_close_open_once — WHERE reopened_at IS NULL partial unique · 열린 마감은 달마다 하나. 조회용 month_close_year_month 도 따로 있다'] }
  Note: '''
  v4.29 · C92-d — 테스트 시나리오 C-39 「월 마감」 · L-123 「마감 후 과거 수정」 · N-140 「마감 후 잘못 발견」.
  마감 달의 쓰기는 409 MONTH_CLOSED — 판정은 lib/month-close 한 곳: 날짜 하나(출결)·달(청구서 발행·이월 처리)·
  기간(휴원·복귀)은 assertMonthOpen/assertRangeOpen, 스케줄 쓰기는 마감 달에 놓인 SER_OCC·EXC 의 모양을
  persist/project 앞뒤로 찍어 달라졌으면 통째로 되돌린다(규칙 전체를 고치면 투영이 지난 달까지 다시 쓰므로 날짜 하나로는 못 막는다).
  명단(SER_STU)은 날짜가 없어 마감이 못 막는다 — N-50. 입금(PAY)은 들어온 사실이라 막지 않는다.
  해제는 행을 지우지 않고 reopened_* 를 채우며 다시 마감하면 새 행이 선다 — 한 달의 마감·해제가 전부 이력이다. 기존 행 0.
  '''
}

Table STU_PAUSE {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id, note: 'ON DELETE CASCADE']
  from_date   date        [not null, note: '휴원 시작일 — 이 날부터 회차에서 빠진다']
  to_date     date        [note: '휴원 종료일(포함) — null 이면 복귀 전까지 무기한. 복귀 처리가 복귀 전날로 당긴다']
  reason      text
  by_id       bigint      [not null, ref: > STAFF.id, note: '누가 잡았나']
  at          timestamptz [not null, default: `now()`]
  resumed_by  bigint      [ref: > STAFF.id, note: '복귀 처리한 사람 — resumed_at 과 짝']
  resumed_at  timestamptz [note: '복귀 처리 시각. null 이면 아직 기간대로다']
  indexes { (student_id, from_date) }
  Note: '''
  v4.28 · C92-c — 테스트 시나리오 C-36 「장기 휴원」 · C-37 「복귀」.
  **회차를 지우는 표가 아니다.** 기간 하나를 적으면 시간표(학생별)·§54 수업료·청구서·명단이 그 기간의 회차를
  「그날만 빠짐」(EXC_STU_OUT · D-R21)과 같은 것으로 읽는다 — 판정은 lib/sql.stuPausedOn 한 곳이다.
  복귀는 to_date 를 복귀 전날로 당기고 resumed_* 를 채운다. 기간은 이력으로 남는다(지우는 길이 없다).
  stu_pause_range CHECK: to_date ≥ from_date.
  stu_pause_no_overlap EXCLUDE (gist · student_id =, daterange(from_date, COALESCE(to_date, infinity), '[]') &&):
  같은 학생의 기간은 겹치지 않는다 — 오류 필터가 409 PAUSE_OVERLAP 으로 번역한다.
  이미 발행한 청구서는 바뀌지 않는다(청구서는 INSERT 뿐이다). 기존 행 0 (N-25).
  '''
}

Table GUARDIAN {
  id            bigserial    [pk]
  student_id    bigint       [not null, ref: > STU.id]
  name          varchar(40)  [not null, note: 'guardian_name_present CHECK — 공백만은 안 된다']
  relation      varchar(20)  [note: '어머니 · 아버지 · 보호자 … 사람이 적는 짧은 말(코드 아님)']
  email         varchar(254) [note: 'guardian_email_shape CHECK — notify/sender.isEmail 과 같은 모양']
  phone         varchar(11)  [note: '숫자만 010xxxxxxxx — notify/sender.phoneDigits · guardian_phone_digits CHECK']
  receive_email boolean      [not null, default: true, note: 'guardian_email_channel CHECK — 켜면 email 이 있어야 한다']
  receive_sms   boolean      [not null, default: false, note: 'guardian_sms_channel CHECK — 켜면 phone 이 있어야 한다']
  is_primary    boolean      [not null, default: false, note: '대표 보호자 — 발송 창에서 미리 체크된다']
  active        boolean      [not null, default: true, note: 'false = 사용 중지. 지우지 않는다(GUARDIAN_SEND 가 가리킨다)']
  created_by    bigint       [not null, ref: > STAFF.id]
  created_at    timestamptz  [not null, default: `now()`]
  indexes {
    student_id [name: 'guardian_student_idx']
    student_id [unique, name: 'guardian_one_primary', note: 'WHERE is_primary 부분 유니크 — 대표는 학생당 하나']
  }
  Note: '''
  v4.43 · TBO-52 DQ3 — 대표 답변(2026-09-25) 「복수 보호자 + 선택 발송, 현재 쓰는 이메일과 Naver SENS 만」. N-42 의 수신처.
  STU 에 칸 두 개를 붙이지 않고 표로 둔 까닭은 답이 「여러 명」이기 때문이다. 발송 때 사람이 보호자와 채널을 고른다.
  guardian_contact_present CHECK: email 또는 phone 중 하나는 있다. guardian_primary_active CHECK: 사용 중지한 사람은 대표가 아니다.
  연락처는 관리 API(@Perm canAdminPage+canCrudAll)에만 실린다 — 강사 응답 어디에도 없다. LOG 에는 가린 값만 적는다.
  채널을 더할 때(예: 알림톡) receive_<채널>·연락처 칸과 CHECK 를 이 표에 함께 새긴다 — 지금은 만들지 않는다(대표 답변).
  기존 행 0 (새 표).
  '''
}

Table GUARDIAN_SEND {
  id          bigserial    [pk]
  request_key uuid         [not null, note: '한 번의 「보내기」 — 재시도는 같은 키로 와서 앞선 결과를 돌려받는다']
  pnoti_id    bigint       [ref: > PNOTI.id, note: '§43 회차 학부모 안내에서 보냈으면 그 줄 — 안내문 등 다른 곳이면 null']
  student_id  bigint       [not null, ref: > STU.id]
  guardian_id bigint       [not null, ref: > GUARDIAN.id]
  channel     varchar(10)  [not null, note: "guardian_send_channel CHECK IN ('email','sms') — notify/sender.SEND_CHANNELS"]
  to_masked   varchar(80)  [not null, note: '가린 받는 곳 ab***@example.com · 010-****-1234 — 원문은 두지 않는다']
  status      varchar(16)  [not null, note: "guardian_send_status CHECK IN ('sent','failed','not_configured')"]
  provider_id varchar(200) [note: '메일 messageId · SENS requestId']
  error       text         [note: '실패·미설정 까닭 — 받는 곳 원문은 가려서 적는다']
  sent_by     bigint       [not null, ref: > STAFF.id]
  sent_at     timestamptz  [not null, default: `now()`, note: '시도 시각 — 실패·미설정 줄도 갖는다']
  wrep_id     bigint       [ref: > WREP.id, note: 'v4.54 · W11 N-54 — §47 주간 묶음에서 보냈으면 그 묶음(guardian_send_wrep_id_fkey). guardian_send_one_source CHECK(pnoti_id IS NULL OR wrep_id IS NULL) — 한 발송은 한 곳에서만 · 옛 행 NULL · migration 1764400000000']
  indexes {
    (request_key, guardian_id, channel) [unique, name: 'guardian_send_once']
    (student_id, sent_at) [name: 'guardian_send_student_idx']
    pnoti_id [name: 'guardian_send_pnoti_idx', note: 'WHERE pnoti_id IS NOT NULL']
    wrep_id [name: 'guardian_send_wrep_idx', note: 'WHERE wrep_id IS NOT NULL']
  }
  Note: '''
  v4.43 · TBO-52 DQ3 — 보호자 발송 원장. 보호자×채널 **시도 한 번에 한 줄**, append-only.
  설정이 없어 시도하지 않은 것도 not_configured 로 남긴다 — 조용히 성공으로 적지 않는다(notify/sender 「보낸 척하지 않는다」).
  PNOTI.sent_at 은 같은 요청에 sent 가 하나라도 있을 때만 찍힌다. 같은 request_key 는 requestKey 권고 잠금 + guardian_send_once 로
  두 번 나가지 않는다. 시드는 넣지 않는다(보낸 적 없는 발송을 지어내지 않는다). 기존 행 0 (새 표).
  '''
}

Table ATT {
  id            bigserial   [pk]
  ser_id        bigint      [not null, ref: > SER.id]
  on_date       date        [not null, note: 'SER_OCC의 원래 날짜 키. 이동 회차도 이 값으로 찾는다']
  result        varchar(12) [not null, note: 'completed | canceled']
  reason        varchar(24) [note: '취소 시 teacher_absent | student_absent | academy | holiday | other 중 하나']
  confirmed_by  bigint      [not null, ref: > STAFF.id]
  confirmed_at  timestamptz [not null, default: `now()`]

  indexes { (ser_id, on_date) [unique] (confirmed_by, confirmed_at) }
  Note: '''
  회차별 출결 **현재값**. 파생 표 SER_OCC는 일정 재투영 때 지워지므로 출결을 저장하지 않는다.
  완료는 reason=NULL, 취소는 허용 사유가 필수다. 생성·정정·초기화의 모든 전후값은
  append-only LOG(entity='ATT')에 남기며, 현재 행은 마지막 확정자·시각만 보관한다 (D-R35).
  '''
}

Table UNAV {
  id          bigserial   [pk]
  staff_id    bigint      [not null, ref: > STAFF.id]
  cycle       smallint    [note: 'v26 2주 회차 흔적 — 표시/묶음용. 새 쓰기는 저장하지 않는다 (N-20 §4-17)']
  dow         smallint    [not null, note: '0=일 … 6=토 — 새 쓰기는 on_date 에서 파생해 저장']
  on_date     date        [note: 'N-20 채택 — 등록 날짜(판정 기준). NULL 은 날짜 식별 불가 legacy 행']
  start_min   smallint    [not null]
  end_min     smallint    [not null]
  reason      text        [not null, note: 'v26 — 필수. 관리자가 조정 가능성을 판단한다']
  created_at  timestamptz [not null, default: `now()`]

  indexes { (staff_id, cycle, dow) (staff_id, on_date) }
  Note: '''
  명세서는 UNAV 를 읽어 겹침만 본다. 등록 규칙은 N-20 채택(2026-09-12 §4-17) —
  **등록 대상 날짜별 7일 전 마감** · 사유 필수 · on_date 가 판정 기준이다 (원본 §15/16 캡처 우선).
  on_date NULL 은 cycle+dow 만으로 2주 안 같은 요일을 식별하지 못하던 legacy 행 —
  강사 화면에 싣지 않고 관리자 조정 대상으로 남긴다.
  1주 안에 생긴 사정은 시스템 밖(강사 단톡방)으로 안내한다 (원본 §16).
  '''
}

Table CONS_ITEM {
  id         bigserial   [pk]
  cons_id    bigint      [not null, ref: > CONS.id]
  seq        smallint    [not null]
  label      varchar(80) [not null]
  required   boolean     [not null, default: false, note: '필수 지정은 종료 전이 게이트(47D-C)와 함께 확정 — 지금은 표기만. v4.54 · 필수는 종료 조건(N-18) — 기본 항목은 빼지 않는다(끝내지 못하면 예외 종료 · W11 N-18-a DQ6)']
  done       boolean     [not null, default: false]
  done_by    bigint      [ref: > STAFF.id]
  done_at    timestamptz
  source     varchar(10) [not null, default: 'template', note: "template=§29 자동 생성분 · manual=「항목 수정」으로 담당이 더한 항목(v4.54 · W11 · N-18-a DQ5 대안 · PATCH /consulting/{id}/items) — cons_item_source_check"]
  created_at timestamptz [not null, default: `now()`]

  indexes { (cons_id, seq) [unique] }
  Note: '''
  §31 진행 항목 원장 (N-18 채택 2026-09-12 §4-17 · 47D-B). 항목과 회차 기록(CONS_SESS)은
  원문에서 구분된다 — TODO 를 분모로 세지 않고, 진행률은 이 원장의 projection 이며
  별도 숫자로 저장하지 않는다 (47D-A). done 이면 done_by·done_at 필수(CHECK),
  체크/해제는 내용 열람(csCanFull) + 종료 전 건에서만 쓴다.
  v4.54 · W11(N-18-a 부분 · 칸 변경 0): 「항목 수정」(더하기 · 이름 바꾸기 · 빼기)은 CONS_EVENT item_added · item_renamed · item_removed(ref_id = 항목 id)로 남는다.
  항목마다 파일은 CONS_FILE.item_id(항목마다 6개 · 같은 컨설팅의 항목만 — trigger cons_file_limit_guard). 9유형 기본 항목표는 보류(N-18-a).
  '''
}

Table CHREQ {
  id          bigserial   [pk]
  ser_id      bigint      [not null, ref: > SER.id]
  on_date     date        [not null]
  req_type    varchar(12) [not null, note: 'time_move | teacher | room | cancel']
  payload     jsonb       [not null]
  reason      text        [not null]
  state       varchar(12) [not null, default: 'pending', note: 'pending | approved | rejected']
  reject_reason text      [note: '반려 시 필수 (D-R13). 신청 사유(reason)를 덮어쓰지 않는다 — v4.18']
  by_id       bigint      [not null, ref: > STAFF.id]
  resolved_by bigint      [ref: > STAFF.id]
  resolved_at timestamptz
  apply_all   boolean     [not null, default: false, note: '선택 회차부터 이후 전체 적용']
  created_at  timestamptz [not null, default: `now()`]

  Note: '''
  겹치면 누구와 겹치는지 표시하고 저장을 막는다. 반영 시 EXC 생성 + LOG (D-R2).
  반영·반려는 `POST /drawer/change-requests/:id/review` 한 경로다 (C42). 반영은 기존 일정
  쓰기(patch·remove)를 그대로 타므로 겹침은 EXCLUDE 가 막고, 막히면 요청도 pending 으로 되돌아간다.
  CHECK chreq_reject_needs_reason: 반려면 reject_reason 이 있어야 한다 (NOT VALID — 옛 행은 검사 안 함).
  payload exact 모양: time_move={startMin,endMin}, teacher={teacherId},
  room={roomId}|{zaccId}, cancel={}. API와 DB CHECK가 같은 네 종류만 허용한다.
  '''
}

// ─────────────────────────────────────────────────────────────── 리포트

Table REP {
  id           bigserial    [pk]
  ser_id       bigint       [not null, ref: > SER.id]
  on_date      date         [not null]
  teacher_id   bigint       [ref: > STAFF.id]
  kind_key     varchar(16)  [ref: > KIND.key]
  lang         varchar(2)   [not null, default: 'ko']
  body         jsonb        [not null, note: '5개 섹션 중 강사 입력 3칸 (D-R15·D-R40) — {} 또는 {content, progress, homework} 세 문자열만']
  state        rep_state_t  [not null, default: 'none']
  written_at   timestamptz
  submitted_at timestamptz
  reviewed_at  timestamptz
  reviewer_id  bigint       [ref: > STAFF.id]
  reject_reason text        [note: 'state=rej 일 때 필수 (D-R13)']
  created_at   timestamptz  [not null, default: `now()`]

  indexes { (ser_id, on_date) [unique] (state, submitted_at) (teacher_id, on_date) }
  Note: '''
  **리포트는 수업 하나에 하나다** — (ser_id, on_date) 가 유니크인 이유다.
  학생은 REP_STU 에 붙는다. 그룹 수업이면 한 리포트에 학생이 여럿이고,
  학부모에게 나가는 PNG 만 **학생 수만큼** 만든다 (CONTRACTS §10.5 · D-R40).
  v4.3 까지 student_id 가 not null 로 남아 있어 유니크 제약과 정면으로 부딪쳤다 —
  그룹 수업 시드를 넣다가 드러났다 (TBO-26).

  시드 57건 · 지난 2주 55/66건 작성.
  KIND.rep=true 인 종류만 대상 (D-4). repState() 가 na/plan 이면 대상 제외.
  강사료 계산의 근거 — **작성했으면 인정한다** (D-R7). state 는 승인 흐름의 표시일 뿐이다.
  state=wait/ok/rej 는 written_at·submitted_at 이 반드시 있다. ok/rej 는 reviewed_at·reviewer_id 가
  반드시 있고, rej 는 공백이 아닌 reject_reason, ok 는 reject_reason=NULL 이다. 그 밖의 상태에는
  검토 컬럼이 남지 않는다 (rep_review_contract · D-R13·D-R34).
  학부모 발송 전문은 5칸 고정 (D-R15) — 저장 형태와의 매핑도 N-2.
  '''
}

Table AUTOREP {
  id          bigserial   [pk]
  ser_id      bigint      [not null, ref: > SER.id]
  on_date     date        [not null]
  body        jsonb       [not null]
  created_at  timestamptz [not null, default: `now()`]
  indexes { (ser_id, on_date) [unique] }
  Note: '자동 생성 리포트. 시드 11건. 자습 등 강사가 쓰지 않는 종류.'
}

Table REP_STU {
  rep_id      bigint [not null, ref: > REP.id]
  student_id  bigint [not null, ref: > STU.id]
  comment     text   [note: '그룹 리포트 학생별 코멘트 — v26 40자 이상']
  deliver     boolean [not null, default: true]
  indexes { (rep_id, student_id) [pk] }
}

Table RSEND {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  on_date     date        [not null]
  rep_ids     jsonb       [not null, note: '학생 단위로 묶어 보낸 리포트들']
  channel     varchar(10) [not null]
  body        text        [not null, note: '발송 원문 스냅샷']
  sent_at     timestamptz [not null, default: `now()`]
  sent_by     bigint      [not null, ref: > STAFF.id]
  request_key uuid        [not null, unique, note: 'HTTP 재시도·더블클릭 idempotency key']
  source_send_id bigint   [ref: > RSEND.id, note: 'null=최초 발송, 값=해당 스냅샷 재발송']
  indexes {
    (student_id, on_date) [unique, note: 'source_send_id IS NULL인 최초 발송만 partial unique']
    (on_date, sent_at)
  }
  Note: '안 쓴 리포트가 있는 학생은 보낼 수 없다 (D-R8).'
}

Table WREP {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  week_of     date        [not null, note: 'v4.54 · 그 주 월요일(KST) — wrep_week_monday CHECK(isodow = 1 · NOT VALID)']
  body        jsonb       [note: 'v4.54 · {summary, by, at} 세 칸만 — wrep_body_summary CHECK(summary 1~2000자 · by 숫자 · at 문자열 · 다른 칸 없음 · NOT VALID)']
  indexes { (student_id, week_of) [unique] }
  Note: '''
  주간 리포트. 코디네이터(TN Learning) 산출물과 대응.
  v4.54 · W11 N-54(migration 1764400000000): 주간 리포트 묶음의 **총평만** 저장한다. 그 주 리포트 본문은 저장하지 않고 읽을 때 모은다(GET /reports/weekly).
  week_of = 그 주 월요일(KST) · body = {summary, by, at} 세 칸만 · wrep_student_id_fkey → STU.
  세 제약(wrep_student_id_fkey · wrep_week_monday · wrep_body_summary) 모두 NOT VALID — 옛 행은 검사하지 않는다 · 옛 모양은 화면이 「예전 방식」으로 잠근다.
  보내기는 GUARDIAN_SEND.wrep_id(DQ3 원장) — 첫 sent 뒤 총평은 잠긴다. 시드는 넣지 않는다(사람이 쓴 글만).
  '''
}

// ─────────────────────────────────────────────────────────────── 안내 · 교재

Table GUIDE {
  id          bigserial     [pk]
  ser_id      bigint        [ref: > SER.id]
  student_id  bigint        [not null, ref: > STU.id]
  teacher_id  bigint        [ref: > STAFF.id]
  reason      varchar(20)   [not null, note: 'new(첫 수업) | teacher_change — 14자라 varchar(12) 에 안 들어갔다 (TBO-26)']
  state       guide_state_t [not null, default: 'draft']
  body        text
  direction   text          [note: 'v4.46 · §44 「지도 방향」 상자 (g4 §44-3) · guide_direction_len CHECK(≤4000) · 옛 안내 NULL']
  admin_note  text          [note: 'v4.46 · §44 「관리자 코멘트 · 강사만」 — 관리자와 받는 강사에게만 보인다. 학부모 발송 본문(body)·안내문 PNG 에 싣지 않는다 · guide_admin_note_len CHECK(≤4000) · 옛 안내 NULL']
  due_on      date
  event_on    date          [note: '첫 수업·강사 교체 사건일. SER_OCC 응답 키는 이 날짜와 ser_id로 서버가 재투영한다.']
  created_by  bigint        [ref: > STAFF.id]
  created_at  timestamptz   [not null, default: `now()`]
  indexes {
    (ser_id, event_on, student_id, reason) [unique, name: 'guide_event_unique']
    (student_id, created_at) [name: 'guide_student_created_idx']
    (state, due_on) [name: 'guide_state_due_idx']
  }
  Note: '''
  **한 번 보내는 것**만 여기 있다. 첫 수업이거나 강사가 바뀐 학생만 대상 (D-R5).
  온라인 줌 링크처럼 **매번 나가는 것은 PNOTI** 다 (§43 「한 번 / 매번」 구분).
  초안 생성 시 서버가 현재 회차·수강생·담당 강사를 다시 검증하고 같은 논리 사건의 중복 생성을 막는다.
  학부모 외부 전달은 v4.43(DQ3)에서 GUARDIAN(수신처) + GUARDIAN_SEND(보호자×채널 시도 원장)로 옮겨 갔다 — 이 표의 상태는 전송 성공을 뜻하지 않는다.
  강사 쪽 전달은 앱 안 알림(NOTI)이다.
  '''
}

Table PNOTI {
  id          bigserial        [pk]
  ser_id      bigint           [ref: > SER.id]
  on_date     date
  audience    pnoti_audience_t [not null, default: 'parent', note: '전달 대상 — §43 「매번」이 줄마다 학부모·강사를 따로 체크한다']
  student_id  bigint           [ref: > STU.id, note: '학부모 행에만 있다']
  staff_id    bigint           [ref: > STAFF.id, note: '강사 행에만 있다']
  channel     varchar(10)      [not null]
  body        text             [not null]
  sent_at     timestamptz
  indexes {
    (ser_id, on_date) [name: 'pnoti_ser_date_idx']
    (student_id, on_date) [name: 'pnoti_student_date_idx']
    (ser_id, on_date, staff_id) [unique, name: 'pnoti_teacher_once', note: "audience='teacher' 부분 유니크 — 강사에게는 회차마다 한 번"]
  }
  Note: '''
  줌 안내 원장. 온라인 수업은 매번 보낸다 (D-R5). channel과 FK는 DB가 방어한다.
  대상이 둘이다 — `parent` 행은 학생을, `teacher` 행은 강사를 가리키고 섞이면 `pnoti_audience_target` 이 막는다.
  기존 행은 전부 `parent` 다: 이 표가 「학부모 안내」였고 `student_id` 가 NOT NULL 이었으므로 다른 값일 수 없었다 (추정 이관 아님).
  학부모 줄의 실제 외부 전달은 **보호자 선택 발송**이 한다 (v4.43 · DQ3 · N-42) — 수신처는 STU 칸이 아니라 GUARDIAN(학생당 N명)이고,
  보호자×채널 시도는 GUARDIAN_SEND.pnoti_id 로 이 줄을 가리킨다. `sent_at` 은 그 원장에 `sent` 가 하나라도 있을 때만 찍히고
  `channel` 은 처음 실제로 나간 채널(email|sms)로 바뀐다. 설정 없음·실패만 있으면 이 줄은 그대로 「보낼 것」이다(보낸 척하지 않는다).
  '''
}

Table GTPL {
  id          bigserial   [pk]
  name        varchar(40) [not null, unique]
  body        text        [not null]
  Note: '안내 문구 템플릿. 시드 5건.'
}

Table BOOK_SUBJECT {
  key         varchar(20) [pk, note: 'english · math · science · social_studies — 원문 §39 컷의 과목 넷만(migration 이 넣는다 · 화면에서 만들지 않는다)']
  name        varchar(40) [not null, note: '원문 낱말 그대로 (English · Math · Science · Social Studies)']
  color       char(7)     [not null, note: '칩 점 · 묶음 머리 · 소분류 글자 색 — 컷 실측(book_subject_color_hex CHECK · #RRGGBB)']
  sort        smallint    [not null]
  Note: 'v4.54 · W11 N-47 교재 과목 코드표(migration 1764300000000). 시간표 과목(SUB)과 다른 축이다 — 교재가 캘린더 과목 옆에 서지 않게 따로 둔다.'
}

Table BOOK_CATEGORY {
  key         varchar(30) [pk, note: 'reading · ela · grammar · speaking_interview · writing · general_math · pre_algebra · biology']
  subject_key varchar(20) [not null, ref: > BOOK_SUBJECT.key, note: 'book_category_subject_key_fkey']
  name        varchar(40) [not null, note: '원문 낱말 그대로 (Reading · Speaking & Interview …)']
  sort        smallint    [not null, note: '묶음 머리 줄에 보이는 차례']
  indexes { (subject_key, key) [unique, name: 'book_category_subject_uq'] }
  Note: 'v4.54 · W11 N-47 교재 소분류 코드표(migration 1764300000000). 원문 §39 컷에 보이는 여덟만 — Social Studies 는 컷에서 머리 줄이 잘려 0줄(짓지 않는다). (subject_key, key) 유니크는 LIB 두 칸 FK(lib_book_category_fk)의 대상이다.'
}

Table LIB {
  id          bigserial   [pk]
  code        varchar(30) [not null, unique]
  title       varchar(120)[not null]
  sub_key     varchar(20) [ref: > SUB.key]
  level       varchar(20)
  grade       varchar(10)
  pages       smallint
  se_te       varchar(4)  [note: 'SE 학생용 · TE 교사용']
  book_subject_key  varchar(20) [ref: > BOOK_SUBJECT.key, note: 'v4.54 · N-47 교재 과목(lib_book_subject_fk) — NULL 이면 「미분류」(옛 교재 전부 · 사람이 편집 창에서 정한다 · 보정 0)']
  book_category_key varchar(30) [note: 'v4.54 · 소분류 — 고른 과목의 것만: (book_subject_key, book_category_key) → BOOK_CATEGORY(subject_key, key) 두 칸 FK(lib_book_category_fk) · 과목 없는 소분류 금지(lib_book_category_needs_subject)']
  book_level        varchar(12) [note: 'v4.54 · foundation | practice | master — lib_book_level_words CHECK · 낱말은 lib/book(BOOK_LEVELS = lead-diag-words 와 같은 셋)']
  grade_from        smallint    [note: 'v4.54 · 학년 범위 시작 — K = 0 · G1~G12 = 1~12 · grade_to 와 함께 비거나 함께 찬다(lib_grade_range)']
  grade_to          smallint    [note: 'v4.54 · 학년 범위 끝 — grade_from 이상 · 12 이하']
  exam_tag          varchar(12) [note: 'v4.54 · sat | map | isee_ssat — lib_exam_tag_words CHECK · 원문 카드 칩 SAT · MAP · ISEE / SSAT']
  Note: '''
  교재. 시드 8건. 카드에 코드·쪽수·배부 횟수·판·SE/TE 표시.
  v4.54 · W11 N-47 두 층 분류 칸 여섯(migration 1764300000000) — 옛 칸 sub_key · level · grade 는 그대로(CHECK 없음). 새 칸이 비면 화면 낱말은 옛 원문(level · grade)으로 돌아간다(중립색).
  두 칸 FK 는 인라인 ref 로 적을 수 없어 여기 적는다 — lib_book_category_fk FOREIGN KEY (book_subject_key, book_category_key) REFERENCES BOOK_CATEGORY(subject_key, key).
  '''
}

Table FILE {
  id          bigserial   [pk]
  kind        varchar(24) [not null, note: '8개 파일 도메인 CHECK. raw 다운로드 권한 판정의 입력']
  name        varchar(200)[not null]
  mime        varchar(100)[not null, note: '클라이언트 입력이 아니라 서버가 파일 이름으로 판정']
  bytes       int         [not null]
  sha256      char(64)    [not null]
  data        bytea       [not null]
  uploaded_by bigint      [ref: > STAFF.id]
  uploaded_at timestamptz [not null, default: `now()`]
  Note: 'Neon 파일 본문. 원본 3MB(base64 JSON 약 4MB)·실제 bytes·sha256 형식은 migration CHECK. 시드 15건.'
}

Table VERS {
  id          bigserial   [pk]
  lib_id      bigint      [not null, ref: > LIB.id]
  edition     varchar(20) [not null]
  file_url    text
  from_date   date
  activated_at timestamptz [not null, default: `now()`, note: '같은 효력일에서 마지막으로 고른 판']
  se_file_id  bigint      [ref: > FILE.id]
  te_file_id  bigint      [ref: > FILE.id]
  indexes { (lib_id, edition) [unique, name: 'vers_lib_edition_unique'] }
  Note: '교재 판. 판 이름은 교재 안에서 유일하며 trigger가 SE/TE FILE.kind까지 검증한다. file_url은 레거시 읽기 호환 전용. 시드 9건.'
}

Table ISSUE {
  id          bigserial   [pk]
  lib_id      bigint      [not null, ref: > LIB.id]
  vers_id     bigint      [ref: > VERS.id]
  student_id  bigint      [not null, ref: > STU.id]
  issued_on   date
  returned_on date
  state       varchar(12) [not null, default: 'ok', note: 'wait | auto | ok | returned']
  progress_page int       [note: '숙제 페이지 기준 현재 쪽수. 퍼센트는 LIB.pages로 파생']
  requested_by bigint     [ref: > STAFF.id]
  approved_by bigint      [ref: > STAFF.id]
  delivered_at timestamptz
  reason      text        [note: 'v4.54 · W11 N-62 배부 사유 — 무슨 교재를 왜 줬는지(슬라이드 37) · 옛 줄 NULL · 진단 점수는 여기 적지 않는다(배부 창이 lead_diag 를 읽기만 · D-R22) · §40 「교재 배부」 줄 메모 · migration 1764310000000']
  form        varchar(8)  [note: 'v4.54 · W11 A 후속 · 7-3 §38-2 배부 형태 — pdf | print(issue_form_words CHECK) · 배부 창에서 고른다(선택) · 옛 줄 NULL = 칩 없음(보정 0) · §38 교재 칸 아래 칩 「PDF」 · 「실물 책」 · 승인 대기 요청 줄에도 선다 · migration 1764330000000']
  indexes { (student_id, lib_id) [name: 'issue_active_book_unique', note: 'returned 제외 partial unique는 migration'] }
  Note: '교재 배부·회수·진도 원장. 상태/시각 순서와 progress>=0은 migration CHECK. v4.54 · 배부 형태는 교재(LIB)가 아니라 배부 줄의 속성이다(리드 채택 · 권고 (가) — §39 서가 카드에는 형태 칩이 없고 승인 대기 요청에도 선다).'
}

Table HIST {
  id          bigserial   [pk]
  entity      varchar(12) [not null, note: 'book | guide']
  ref_id      bigint      [not null]
  action      varchar(20) [not null]
  by_id       bigint      [ref: > STAFF.id]
  at          timestamptz [not null, default: `now()`]
  Note: '교재·안내 이력. 시드 18건.'
}

Table GPAPACK {
  id          bigserial   [pk]
  pack_type   varchar(12) [not null, note: 'exam(시험 대비) | self(자습) — 두 가지만 받는다']
  title       varchar(120)[not null]
  memo        text
  state       varchar(12) [not null, default: 'pending', note: 'pending | delivered | received']
  legacy_state varchar(12) [note: '이관 전 원문 상태. 승인과 실제 전달은 구분한다. 이미 옛33을 적용한 DB는 원문 미상 NULL']
  effective_on date       [note: '신규·수정행 필수. 레거시 null 추정 이관 금지용 NOT VALID CHECK']
  coordinator_id bigint   [ref: > STAFF.id, note: '신규·수정행 필수. 레거시 null 추정 이관 금지용 NOT VALID CHECK']
  created_by  bigint      [ref: > STAFF.id]
  delivered_by bigint     [ref: > STAFF.id]
  delivered_at timestamptz
  received_by bigint      [ref: > STAFF.id]
  received_at timestamptz
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  Note: '§41 자료 전달 부모. 종류와 전달→수령 순서는 migration CHECK.'
}

Table GPAPACK_STUDENT {
  gpapack_id  bigint      [not null, ref: > GPAPACK.id]
  student_id  bigint      [not null, ref: > STU.id]
  indexes { (gpapack_id, student_id) [pk] }
  Note: '자료 전달의 다학생 명단.'
}

Table GPAPACK_LIB {
  gpapack_id  bigint      [not null, ref: > GPAPACK.id]
  lib_id      bigint      [not null, ref: > LIB.id]
  vers_id     bigint      [ref: > VERS.id, note: '만들기/수정 시 적용일의 판 스냅샷']
  indexes { (gpapack_id, lib_id) [pk] }
  Note: '자료 전달의 다교재 명단. 현재 판이 바뀌어도 과거 전달 파일은 바뀌지 않는다.'
}

// ─────────────────────────────────────────────────────────────── 회계

Table RATE {
  id          bigserial   [pk]
  kind_key    varchar(16) [not null, ref: > KIND.key]
  sub_key     varchar(20) [ref: > SUB.key]
  heads       smallint    [not null, default: 1, note: 'N-17 §4-17 ① — 인원 구간. 적용 = 인원 이하의 최대 heads. CHECK ≥ 1']
  unit_price  int         [not null]
  from_date   date        [not null]
  Note: '''
  프로그램별 단가 — 인원 구간별 (§54: 인원↑ → 1인 단가↓·총액↑). 수정하면 전체 재계산.
  기존 행은 1인 기준으로 재해석(마이그레이션 DEFAULT 1 — 소비처 0 확인 뒤).
  유일성은 (kind_key, COALESCE(sub_key,''), heads, from_date) 표현식 인덱스(migration).
  수업당 총액 = Σ(학생별 STURATE 예외 ?? 적용 구간 단가) — lib/rules.rosterPricing 한 곳.
  '''
}

Table STURATE {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  kind_key    varchar(16) [ref: > KIND.key]
  unit_price  int         [not null]
  from_date   date        [not null]
  reason      text        [note: 'v4.31 · 예외 사유 — 새 행은 필수 (sturate_reason_present CHECK · NOT VALID · 옛 시드 2행 보정 0) (H-81)']
  by_id       bigint      [ref: > STAFF.id, note: 'v4.31 · 누가 적었나']
  created_at  timestamptz [not null, default: `now()`]
  Note: '''
  학생별 단가 예외. 청구서·§54·§79 카드가 같은 순서로 읽는다 — 학생 예외(sturate · 종류 지정 우선) → 기본 단가표(rate · 그 날짜의 인원 구간).
  v4.31 · C94-d — 테스트 시나리오 H-81 「형제 할인 · 동생 단가만 · 사유가 없으면 실패」. POST /accounting/sturates 가 적는다(대표 · canMoney · LOG).
  '''
}

Table WAGE {
  id          bigserial   [pk]
  staff_id    bigint      [not null, ref: > STAFF.id]
  rate        int         [not null, note: '기본 시급(원/시간)']
  from_date   date        [not null, note: '이 날짜의 수업부터 적용 — 소급 없음 (D8 확정)']
  reason      text
  approved_by bigint      [ref: > STAFF.id]
  created_at  timestamptz [not null, default: `now()`]

  indexes { (staff_id, from_date) [unique] }
  Note: '''
  명세서의 WAGE(강사별 시급)에 **v26 의 이력 개념을 얹었다**.
  기준은 수업일이지 정산월이 아니다 — 월중에 바뀌면 그 달 안에서 두 단가가 섞인다.
    SELECT rate FROM WAGE WHERE staff_id=$1 AND from_date<=$class_date
     ORDER BY from_date DESC LIMIT 1;
  '''
}

Table INV {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  enr_id      bigint      [ref: > ENR.id, note: '수강 내역에서 자동 생성 가능']
  year_month  varchar(7)  [not null]
  inv_type    varchar(16) [not null, note: '청구 종류 **넷** — tuition · consulting · diag_intake · exam_fee (대표 결정 2026-09-13 · N-37 · §57 「그 밖의 수입」 세 줄 + 수업료). inv_type_check NOT VALID 로 굳혔다. 예전 주석의 「6종」은 근거가 없었다']
  title       varchar(80) [not null]
  amount      int         [not null, note: '들어와야 할 금액. 회계 화면에서 placeholder 로 쓰인다']
  detail      jsonb
  state       inv_state_t [not null, default: 'draft']
  issued_on   date
  due_on      date        [note: '납부 기한 — v4.54 · 분납 일정(INV_INSTALLMENT)이 있으면 마지막 회차의 예정일 (N-79). 연체 판정은 이 칸이 아니라 지금 기한(lib/exec-areas invDueSql — 못 채운 가장 이른 회차의 예정일)을 본다']
  sent_at     timestamptz
  created_by  bigint      [ref: > STAFF.id]

  paid_amount int         [not null, default: 0, note: 'state=partial 일 때 지금까지 받은 합 (D-R37)']
  paid_at     timestamptz
  proof_url   text        [note: '입금 증빙 — Vercel Blob (D-R42)']
  memo        varchar(500)
  cs_id       bigint      [ref: > CONS.id, note: '어느 컨설팅에서 전환된 청구서인가 — 원문 §28 「INV 에 csid 로 연결」. 연결이지 소유가 아니다: 납부 기록은 CONS_PAY 에 그대로 남는다']

  indexes {
    (student_id, year_month)
    (state, due_on)
    (cs_id) [unique, name: 'inv_cs_id_live_uniq', note: 'cs_id IS NOT NULL AND state <> void — 한 컨설팅에 살아 있는 청구서는 하나']
  }
  Note: '''
  시드 6건 ₩9,720,000. aging() 이 기한 경과일수로 미수를 분류한다.

  **입금 명세서** (D-R37) — 「~학생이 ~과목을 몇 번 수강했으니 총 얼마」.
  줄(INV_LINE)은 서버가 occ() 로 세어 초안을 만들고, 매니저 이상이 확정해 저장한다.
  상태 전이는 unpaid → partial → paid 와 → void 뿐이며 되돌리기가 없다.
  같은 명세서를 두 사람이 동시에 완납 처리하는 경합은 SELECT … FOR UPDATE 로 막는다.
  v4.54 · W11(migration 1764200000000): 지연 제약 트리거 inv_installment_sum_on_inv(AFTER UPDATE OF amount · DEFERRABLE INITIALLY DEFERRED · 함수 inv_installment_sum_guard)가
  분납 일정이 있는 청구서의 amount 가 바뀌면 커밋 때 회차 합 = amount 를 다시 본다. 월 마감 · 해제와 발행 · 이월 · 컨설팅 전환은 같은 달 열쇠(advisory lock)를 잡는다 — 칸 변경 0.
  '''
}

Table INV_INSTALLMENT {
  id      bigserial [pk]
  inv_id  bigint    [not null, ref: > INV.id, note: '지우면 함께 지워진다(inv_installment_inv_fk · ON DELETE CASCADE) — 일정은 청구서의 일부다']
  seq     smallint  [not null, note: '회차 — 1부터 · 예정일 순으로 매긴다(inv_installment_seq_positive CHECK seq >= 1)']
  due_on  date      [not null, note: '그 회차의 예정일']
  amount  int       [not null, note: '그 회차의 금액(inv_installment_amount_positive CHECK amount > 0) — 회차 합 = INV.amount']

  indexes {
    (inv_id, seq)    [unique, name: 'inv_installment_seq_uniq']
    (inv_id, due_on) [unique, name: 'inv_installment_due_uniq']
  }
  Note: '''
  v4.54 · W11 N-79 채택 — 선택 분납 일정(migration 1764200000000). 없으면 INV.due_on 하나로 기한을 본다(옛 청구서 보정 0 · N-25).
  합 = INV.amount 는 발행 경로가 먼저 막고, 지연 제약 트리거 inv_installment_sum_check(이 표 · AFTER INSERT OR DELETE OR UPDATE) ·
  inv_installment_sum_on_inv(INV.amount 갱신)가 커밋 때 다시 본다(둘 다 함수 inv_installment_sum_guard).
  연체 = 누적 입금(INV.paid_amount)이 못 채운 가장 이른 회차의 예정일 — lib/exec-areas invDueSql 한 조각.
  발행 뒤 고치는 길은 없다(청구서 INSERT 만 원칙) — 바꾸려면 취소하고 다시 낸다.
  '''
}

Table INV_LINE {
  id          bigserial   [pk]
  inv_id      bigint      [not null, ref: > INV.id]
  sub_key     varchar(16) [ref: > SUB.key, note: '과목']
  label       varchar(80) [not null, note: '표시용 — "고2 수학"']
  count       int         [not null, note: '수강 횟수 — occ() 로 센 취소 아닌 회차 수. 사람이 세지 않는다. 이월 줄(v4.27 · C-35)은 음수 — 지난달에서 넘어온 회차를 이 달 청구에서 뺀다']
  unit_price  int         [not null]
  amount      int         [not null, note: 'count × unit_price — 저장 시점 스냅샷']
  seq         smallint    [not null, default: 0]

  indexes { (inv_id, seq) }
  Note: '''
  D-R37. 「몇 번 수강했는가」를 프론트가 세면 EXC(예외)를 빠뜨린다 — 서버가 센다.
  단가가 나중에 바뀌어도 이미 낸 명세서는 흔들리지 않도록 amount 를 스냅샷으로 굳힌다.
  '''
}

Table PAY {
  id          bigserial   [pk]
  inv_id      bigint      [ref: > INV.id, note: 'NULL 이면 매니저가 직접 넣은 건 (A-D1)']
  student_id  bigint      [ref: > STU.id]
  amount      int         [note: '실제 입금액. NULL = 아직 아무도 확인하지 않음']
  paid_on     date
  method      varchar(16)
  reason      text        [note: '청구액과 다를 때 필수']
  entered_by  bigint      [ref: > STAFF.id]
  entered_at  timestamptz
  confirmed_by bigint     [ref: > STAFF.id, note: '확정 — 매니저 이상 (D-R39 · D-R37)']
  confirmed_at timestamptz

  indexes { (inv_id) (paid_on) }
  Note: '''
  시드 14건. **기대값(INV.amount)은 placeholder 로만 보여 주고 실측값(amount)을 사람이 넣는다.**
  미리 채워 두면 확인하지 않고 그대로 저장한다 — amount NULL 이 "아직 확인 안 함"을 뜻한다.
  넣는 것도 확정하는 것도 **매니저 이상**이다 (D-R39). 강사는 이 화면을 볼 수 없다.
  '''
}

Table CARRY {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  from_month  text        [not null, note: '못 해 준 수업이 있던 달 — YYYY-MM']
  to_month    text        [not null, note: '넘겨 받는 달 — YYYY-MM']
  amount      int         [not null]
  sessions    int         [not null, note: '못 해 준 회차 수']
  inv_id      bigint      [ref: > INV.id, note: '근거가 된 완납 청구서']
  by_id       bigint      [not null, ref: > STAFF.id]
  at          timestamptz [not null, default: `now()`]

  indexes {
    (student_id, from_month) [unique, name: 'carry_once']
    (to_month) [name: 'carry_to_month']
  }
  Note: '''
  §54 이월 처리 원장. 결제됐지만 정해진 시수를 채우지 못한 수업만 다음 달로 넘긴다.
  carry_month_shape는 두 달을 YYYY-MM으로 제한하고, carry_forward는 다음 달이 이전 달보다
  뒤인지 확인하며, carry_positive는 금액과 회차가 모두 양수인지 강제한다 (migration 1759500000000).
  '''
}

Table PAYOUT {
  id          bigserial   [pk]
  staff_id    bigint      [not null, ref: > STAFF.id]
  year_month  varchar(7)  [not null]
  hours       numeric(6,2)[not null, note: '취소·휴강 제외 (D-R11) · 확정 때는 쓴 수업 + 보정 줄 시간(N-51 · v4.54 M2)']
  gross       int         [not null]
  late_rep_cut int        [not null, default: 0, note: '리포트 지각 차감 — 1시간↑ 5,000 · 4시간↑ 10,000 (D-R32)']
  late_cls_cut int        [not null, default: 0, note: '수업 지각 차감(분 단위)']
  income_tax  int         [not null, default: 0, note: '소득세 3% · 원 단위 절사 (D-15)']
  local_tax   int         [not null, default: 0, note: '지방소득세 = 소득세 10% · 원 단위 절사']
  net         int         [not null]
  state       varchar(12) [not null, default: 'draft', note: 'draft | confirmed | paid']
  confirmed_by bigint     [ref: > STAFF.id]
  confirmed_at timestamptz

  indexes { (staff_id, year_month) [unique] }
  Note: '''
  시드 3건 · 13명 ₩4,836,692.
  wageSheet(강사, 년월) 이 리포트 기준으로 시수를 집계한다 — **작성했으면 인정** (D-R7).
  반려·재승인으로는 깎이지 않는다. 깎이는 것은 지각 차감(late_rep_cut)뿐이다.
  본인만 조회. 다른 강사의 시급·정산은 어떤 화면에서도 보이지 않는다.
  3.3% 를 한 번에 곱하지 않는다 — 신고가 두 항목으로 나뉘므로 계산도 나뉜다.
  '''
}

Table PAYOUT_LINE {
  id           bigserial    [pk]
  payout_id    bigint       [not null, ref: > PAYOUT.id, note: 'payout_line_payout_fk · ON DELETE RESTRICT — 굳힌 근거는 정산과 함께 조용히 사라지지 않는다']
  ser_id       bigint       [not null, ref: > SER.id, note: 'payout_line_ser_fk · RESTRICT · v4.54 M2 에서 NOT NULL(회차 키)']
  on_date      date         [not null, note: '회차 키(ser_id, on_date) · v4.54 M2 에서 NOT NULL']
  kind_key     varchar(16)  [ref: > KIND.key, note: 'payout_line_kind_fk · RESTRICT']
  hours        numeric(4,2) [not null]
  unit_rate    int          [not null, note: '수업일 기준 시급 스냅샷 — 이력이 정정돼도 안 흔들린다']
  amount       int          [not null, note: '시급×시간(분 단위 정수 절사) — 가산 · 차감은 따로 (N-36)']
  cut          int          [not null, default: 0, note: '리포트 지각 차감(D-R32 · 최초 제출 시각)']
  bonus        int          [not null, default: 0, note: 'v4.54 M2 · 가산 합(N-93) — bonus_detail 이 종류별 내역']
  bonus_detail jsonb        [not null, default: `'[]'::jsonb`, note: 'v4.54 M2 · [{kind, amount}] — CHECK payout_line_bonus_detail_array']
  correction   boolean      [not null, default: false, note: 'v4.54 M2 · 보정 줄 — 확정된 달의 회차를 다음 미확정 달에 얹어 지급 (N-51)']

  indexes {
    (ser_id, on_date) [unique, name: 'payout_line_ser_on_uniq', note: '한 회차는 한 번만 지급된다 — 23505 → 409 PAYOUT_LINE_DUPLICATE']
    payout_id         [name: 'payout_line_payout_idx']
  }
  Note: '''
  v4.54 · W11 M2 · N-36 ① 채택(migration 1764900000000) — 지급 확정 트랜잭션이 회차마다 한 줄. 확정된 달의 시트 · 상세 · 강사 히스토리는 이 줄을 읽는다(시급 · 가산 규칙이 나중에 바뀌어도 안 흔들린다 · D8).
  CHECK payout_line_nonneg (hours · unit_rate · amount · cut · bonus >= 0) · payout_line_bonus_detail_array.
  확정 뒤에 쓴 회차는 원래 달 다음의 첫 미확정 달 정산에 correction = true 줄로 든다(유일 색인이 두 번 지급을 막는다 · N-51).
  옛 행이 규칙에 어긋나면(회차 키 빈칸 · 겹침 · 없는 정산/규칙/종류 · 음수) 마이그레이션이 고치지 않고 멈춘다(N-25).
  '''
}

Table PAYOUT_BONUS_RULE {
  id         bigserial   [pk]
  kind       varchar(20) [not null, note: 'per_session 한 번에 · kinder_hourly 시급에 더함 · group_per_student 한 명당 — CHECK payout_bonus_rule_kind_words']
  kind_key   varchar(16) [ref: > KIND.key, note: '「한 번에」만 필수 · 나머지는 NULL — CHECK payout_bonus_rule_kind_key_pair · payout_bonus_rule_kind_fk · RESTRICT']
  amount     int         [not null, note: '원 · 0 = 그 날부터 멈춤 — CHECK payout_bonus_rule_amount_range(0..1,000,000)']
  from_date  date        [not null, note: '적용 시작일 — 서버가 오늘 이후만 받는다(소급 없음 · 409 BONUS_RETROACTIVE)']
  reason     text
  set_by     bigint      [not null, ref: > STAFF.id, note: 'payout_bonus_rule_set_by_fk · RESTRICT']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (kind, `COALESCE(kind_key, '')`, from_date) [unique, name: 'payout_bonus_rule_slot_day_uniq', note: '같은 칸 같은 날 한 줄 — 409 BONUS_SAME_DAY']
  }
  Note: '''
  v4.54 · W11 M2 · N-93 채택(migration 1764900000000) — 강사료 가산 규칙. 시급 · 단가표처럼 새 줄로만 바꾼다(지난 줄 불변). 처음엔 비어 있다 — D1(§4-12) 금액을 데이터로 넣지 않는다.
  셈은 lib/payout-sheet.lessonBonus 한 곳(시트 · 확정 · 강사 히스토리). Kinder 는 수업을 가를 표시가 없어 0. canWage 가 적는다 · 감사 payout.bonus_rule.
  시드는 넣지 않고 운영 전환(golive-reset)은 비운다. 그룹 가산 학생 수 · 「건당 정액」 · 미확정 달 소급은 PLANNING N-125 ~ N-127(열림).
  '''
}

Table ACCT_PRIVACY {
  key     varchar(16) [pk, note: 'wage 시급 비공개 · consulting 컨설팅 비공개 — CHECK acct_privacy_key_words']
  private boolean     [not null, default: false]
  set_by  bigint      [ref: > STAFF.id, note: 'acct_privacy_set_by_fk · RESTRICT · 운영 전환이 계정을 지우면 비고 시각은 남을 수 있다']
  set_at  timestamptz [note: 'CHECK acct_privacy_set_at_with_by (set_by 가 있으면 set_at 도)']
  Note: '''
  v4.54 · W11 M2 · N-94 채택(migration 1764900000000) — 회계 탭 줄의 두 스위치. 켜고 끄기 = 대표 판정(canCeoSetAcctPrivacy) · 감사 acct.privacy on/off.
  켜면 그 줄 금액은 비공개 열람(canHide)과 본인에게만 보인다 · 합계는 그대로. migration 이 두 줄(꺼짐)을 넣고 시드 초기화(--reset)는 비운다 — 행이 없으면 꺼짐으로 읽는다.
  운영 전환(golive-reset)은 이 표를 남긴다(대표가 정한 설정). 서랍 결재함의 시급 요청 금액 · 컨설팅 계약 금액 입력은 가리지 않는다 — PLANNING N-128(열림).
  '''
}

Table EXPENSE {
  id          bigserial   [pk]
  spend_on    date        [not null]
  category    varchar(30) [not null, note: 'rent 임대료 · book 도서교재비 · supply 소모품비 · ent 접대비 · fee 지급수수료 · etc 기타 — 간이 5분류(A-D5) + 임대료. CHECK expense_category_code']
  merchant    varchar(80)
  purpose     text
  requested_amount int    [note: '법인카드 — 직원이 올린 금액. placeholder 로 쓰인다']
  amount      int         [note: '확정 금액. 승인자가 넣는다. NULL = 미심사']
  reason      text        [note: '신청액과 다를 때 필수']
  receipt_url text        [note: '없으면 승인 불가']
  requester_id bigint     [ref: > STAFF.id]
  filed_by    bigint      [ref: > STAFF.id, note: 'v4.37 · **실제로 올린 사람** — 대표가 직원 대신 올릴 때 requester_id 와 갈린다 (ON DELETE RESTRICT · expense_no_self_file_review). 이 칸이 없던 동안 「남의 이름으로 올린 뒤 자기가 승인」이 A-5 를 비켜갔다. 옛 행은 NULL — 누가 올렸는지 모른다 (N-25 · 보정 0)']
  state       varchar(12) [not null, default: 'pending', note: 'pending | approved | rejected — CHECK expense_state_words. 대표 보고는 approved 만 센다']
  reviewer_id bigint      [ref: > STAFF.id]
  reviewed_at timestamptz
  created_at  timestamptz [not null, default: `now()`]

  indexes { (state, created_at) (spend_on) (filed_by) }
  Note: '''
  명세서의 EXPENSE(지출)에 **법인카드 승인 흐름을 얹었다** — 별도 표를 만들지 않는다.

  2026-09-12 (C36-b) — 여기 적혀만 있던 규칙을 **DB 가 거부하도록** 옮겼다
  (migration 1758500000000 · A-D3·A-D5 채택). 표에는 제약이 하나도 없었고
  실제로는 무엇이든 들어갔다.
    expense_category_code       분류는 코드표 6개뿐 (간이 5분류 + 임대료)
    expense_state_words         pending | approved | rejected
    expense_amount_le_requested amount <= requested_amount — 증액은 재신청 (A-D3)
    expense_no_self_review      reviewer_id <> requester_id — 본인 신청 자기 승인 금지
    expense_no_self_file_review reviewer_id <> filed_by — v4.37 (S2) · **대신 올린 사람도 심사하지 못한다**
  레거시 misc 는 etc 로 **낱말만** 옮겼다(뜻 동일 · 1756800000000 선례). 추정 이관이 아니다.
  카드 **신청** 화면은 원본 61컷에 없어 미배선 — 이번 청크는 승인/반려뿐이다.
  '''
}

// ─────────────────────────────────────────────────────────────── 운영

Table CONS {
  id          bigserial    [pk]
  cons_type   varchar(20)  [not null, note: '종류 10종']
  stage       varchar(12)  [not null, note: 'contract | running | done']
  contract_step smallint   [note: '1~5 또는 null(계약 중 미정). running/done은 반드시 5. 계약서 → 피드백 → 학부모 전달 → 서명본 → 수납']
  amount      int
  sessions    smallint     [note: '1~32767 또는 null(미정)']
  start_on    date         [note: '§29 컨설팅 시작일. created_at 감사 시각과 구분']
  end_on      date
  requester   varchar(8)   [note: 'mother | father 또는 null(레거시). cons_requester_check']
  owner_id    bigint       [ref: > STAFF.id]
  share       cons_share_t [not null, default: 'all', note: 'csCan() 목록 필터 · csCanFull() 내용 접근']
  deleted_at  timestamptz  [note: '물리 삭제 대신 보관한 시각']
  deleted_by  bigint       [ref: > STAFF.id, note: 'deleted_at과 함께 있거나 함께 null']
  created_at  timestamptz  [not null, default: `now()`]
  Note: '''
  공개 범위는 role 권한과 독립된 두 번째 층 (D-5 · D-R39).
  TBO-47C migration 11: cons_stage_check (contract/running/done), cons_contract_step_check (1~5),
  cons_paid_stage_check (계약 외 step=5, NULL 차단), cons_sessions_check (>0).
  C79 migration 1759900000000: start_on/requester/deleted pair와 날짜 순서 CHECK, owner/deleted_by FK.
  v4.54 · W11(N-18-a DQ6 · 칸 변경 0): 예외 종료의 사유 · 승인자 · 남은 항목/회차는 칸이 아니라 LOG(entity CONS · action close_exception) before/after — 상세 closeReason 이 되읽는다.
  컨설팅 전환 청구서(INV.cs_id)는 받는 학생을 고르고(학생이 여럿이면) 그 달이 마감이면 409 MONTH_CLOSED(같은 달 열쇠 · M1 과 같은 축).
  '''
}

Table CONS_STU  { cons_id bigint [ref: > CONS.id]  student_id bigint [ref: > STU.id]  indexes { (cons_id, student_id) [pk] } }
Table CONS_PICK { cons_id bigint [ref: > CONS.id]  staff_id   bigint [ref: > STAFF.id] indexes { (cons_id, staff_id) [pk] } Note: 'share=picked 일 때 볼 수 있는 사람' }

Table CONS_FILE {
  file_id     bigint      [pk, ref: > FILE.id]
  cons_id     bigint      [not null, ref: > CONS.id]
  role        varchar(12) [not null, note: 'draft | revision | signed | item (v4.54 · W11 · N-63) — cons_file_role_check']
  item_id     bigint      [ref: > CONS_ITEM.id, note: 'v4.54 · W11 · N-63 — 항목 파일이면 그 항목(cons_file_item_fk · 같은 컨설팅의 항목만 — trigger 가 cons_file_item_cons 로 막는다) · 계약 파일은 NULL. cons_file_item_pair_check: (role = item) = (item_id IS NOT NULL)']
  created_by  bigint      [not null, ref: > STAFF.id]
  created_at  timestamptz [not null, default: `now()`]
  indexes {
    (cons_id, created_at, file_id)
    (item_id, created_at, file_id) [name: 'cons_file_item_idx', note: 'WHERE item_id IS NOT NULL']
  }
  Note: '''
  §30 계약서·수정본·서명본 · §31 항목 파일 연결 원장. CONS 부모 잠금 trigger가 한 컨설팅의 전체 파일을 최대 10개로 제한한다.
  v4.54 · W11 migration 1764500000000 — 한 트리거 cons_file_limit_guard_trigger(BEFORE INSERT · 함수 cons_file_limit_guard())가 CONS 부모를 잠근 뒤
  계약 파일(item_id NULL)은 컨설팅마다 최대 10개(cons_file_limit), 항목 파일은 항목마다 최대 6개(cons_file_item_limit)로 따로 세고, 다른 컨설팅의 항목이면 cons_file_item_cons 로 막는다(셋 다 ERRCODE 23514).
  옛 행은 전부 계약 파일(item_id NULL · 짝 CHECK 이미 만족 · 보정 0).
  '''
}

Table CONS_FEEDBACK {
  id          bigserial   [pk]
  cons_id     bigint      [not null, ref: > CONS.id]
  body        varchar(2000) [not null, note: '공백만 저장 금지']
  created_by  bigint      [not null, ref: > STAFF.id]
  created_at  timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  resolved_by bigint      [ref: > STAFF.id, note: 'resolved_at과 함께 있거나 함께 null']
  indexes { (cons_id, created_at, id) }
  Note: '§30 계약 피드백 append-only 원장. 해결은 같은 행의 resolved stamp만 한 번 기록한다.'
}

Table CONS_EVENT {
  id          bigserial   [pk]
  cons_id     bigint      [not null, ref: > CONS.id]
  event_type  varchar(24) [not null, note: 'created | share_changed | file_added | file_removed | feedback_added | feedback_resolved | parent_delivered | payment_added | archived | session_added | session_written | closed (v4.33 · C95 — 뒤 셋) | item_done | item_undone (v4.40 · S7 — 켬·끔을 두 낱말로 나눈다: append-only 원장에서 마지막 줄이 곧 지금 상태여야 하고, ref_id 만으로는 어느 쪽인지 알 수 없다) | item_added | item_renamed | item_removed (v4.54 · W11 · N-18-a 원문 §31 「항목 수정」 — 켬·끔과 같은 원장 · ref_id = 항목 id · cons_event_type_check). 항목 파일 올리기/빼기는 기존 file_added · file_removed(ref_id = 파일 id)']
  ref_id      bigint      [note: '파일·피드백·납부·회차·항목(v4.40) 원장 식별자. 종류별 다형 참조라 FK로 추정하지 않음']
  by_id       bigint      [not null, ref: > STAFF.id]
  created_at  timestamptz [not null, default: `now()`]
  indexes { (cons_id, created_at, id) }
  Note: '§30 계약 단계 행위 감사 원장. 학부모 재전달도 새 행으로 남기며 최신 전달은 created_at/id로 투영한다.'
}

Table CONS_PAY {
  id          bigserial   [pk]
  cons_id     bigint      [not null, ref: > CONS.id]
  amount      int         [not null, note: 'cons_pay_amount_positive (>0) — 0 원은 기록이 아니라 실수다']
  paid_on     date        [not null]
  memo        varchar(80)
  by_id       bigint      [not null, ref: > STAFF.id, note: '넣은 사람']
  created_at  timestamptz [not null, default: `now()`]
  indexes { (cons_id, paid_on) }
  Note: '''
  §28 컨설팅 회계의 납부 원장 — 원문 `CONS.pay[]`.

  **PAY 표를 빌려 쓰지 않는다.** PAY 는 INV.id 에 매달려 있는데, 컨설팅 수납은 청구서 없이도
  들어온다 (슬라이드 30 「수납 시 청구서(INV) 생성 **가능**」 — 가능이지 필수가 아니다).

  받은 합을 저장하는 칸은 **어디에도 없다.** 합계는 읽을 때 이 줄들을 더해서 만든다 (D-R37).
  청구서로 전환해도 이 줄은 그대로 남는다 — INV.cs_id 는 연결이지 옮김이 아니다.
  TBO-48 C58 migration 1759300000000.
  '''
}

Table CONS_SESS {
  id          bigserial   [pk]
  cons_id     bigint      [not null, ref: > CONS.id]
  seq         smallint    [not null, note: '1~32767 · cons_sess_seq_check (>0)']
  on_date     date
  who         text
  what        text
  why         text
  how         text
  ser_id      bigint      [ref: > SER.id, note: '회차 기록 시 스케줄이 생긴다 — v4.33(C95): 그날 담당의 컨설팅 회차가 있으면 그 SER, 없으면 하루짜리(ONCE) SER 를 시간표 쓰기 그대로 만든다']
  result      text        [note: 'v4.45 · §31 회차 본문의 「결과」(인용 상자 · 31-08)']
  next_until  text        [note: 'v4.45 · §31 「다음까지」(31-08) — PATCH …/sessions/{sessId} 가 새로 적거나 바꾸면 같은 트랜잭션에서 건 담당의 TODO(src=consulting · 제목 「컨설팅 N회차 다음까지 — …」 · 기한 = 그 뒤 첫 회차) 한 줄(있으면 제목만 고친다) + 담당 NOTI(etc) — 슬라이드 31 연동']
  indexes { (cons_id, seq) [unique, name: 'cons_sess_cons_seq_uniq'] }
  Note: '''
  회차별 육하원칙 기록. 실측: 기록하면 SER 35→36 · TODO 5→6.
  v4.33 (C95 · I-91) — POST /consulting/{id}/sessions 가 날짜 여러 개를 한 번에 적는다: seq 는 max+1 부터 날짜 오름차순, who 는 「담당 · 학생」을 서버가 조립,
  날짜마다 담당의 할 일(TODO.src=consulting · cons_id) 한 줄. 육하원칙은 PATCH …/sessions/{sessId} 가 보낸 칸만 적고 셋이 다 차면 그 할 일을 접는다.
  「한 회차」는 on_date 가 오늘 이하(또는 미정)인 행 — 앞으로 잡아 둔 날짜는 기록이지 완료가 아니다(N-18 「기록 ≠ 완료」). 종료(I-95)는 N-18 채택
  「필수 항목 + 약정 회차 후 명시 종료」를 서버가 판정하고 앞으로 잡아 둔 회차가 남아 있으면 막는다. 표 변경 0.
  '''
}

Table CPL {
  id          bigserial   [pk]
  area        cpl_area_t  [not null]
  student_id  bigint      [ref: > STU.id]
  stage       varchar(12) [not null, note: 'received | acting | closed — CHECK cpl_stage_words (v4.25)']
  body        text        [not null]
  action      text
  result      text
  teacher_changed boolean [not null, default: false]
  owner_id    bigint      [ref: > STAFF.id]
  due_on      date        [note: 'v4.32 · 대응 기한 (J-98) — 열린 건에만 「N일 지남」을 센다. 옛 행 NULL (N-25)']
  severity    varchar(8)  [note: 'v4.32 · light | normal | severe — 원본 §67 카드의 가벼움 · 보통 · 심각 (cpl_severity_words CHECK · NULL 허용). 낱말은 lib/complaint-words 한 곳']
  requester   varchar(8)  [note: 'v4.49 · mother | father — 원본 §67 카드 「고은설 어머니」(누가 알렸는지 · 67-5). cpl_requester_words CHECK(NOT VALID · NULL 허용) · 낱말은 lib/complaint-words(§29 「누가 요청」과 같은 말) · 옛 행 NULL (N-25)']
  closed_at   timestamptz [note: 'v4.49 · 「결과」로 옮긴 순간 (67-6 · 원본 §67 결과 칸 「08-12」) — PATCH /ops/complaints/{id} 가 closed 로 옮길 때 서버가 찍고, 결과 칸에 머무는 동안은 그대로, 다시 열면 비운다(입력 칸 아님 · ComplaintDto.closedOn 은 KST 날짜). cpl_closed_at_stage CHECK(closed_at IS NULL OR stage = closed · NOT VALID). 옛 결과 행 NULL — 접수일·LOG 로 짓지 않는다 (N-25)']
  created_at  timestamptz [not null, default: `now()`]
  Note: '''시드 8건. 접수 → 대응 → 결과.
    v4.32 (C93) — POST /ops/complaints(「+ 접수」 · 언제나 received · 담당 알림 · LOG) · PATCH /ops/complaints/{id}(보낸 칸만 · acting 은 담당이, closed 는 결과가 있어야 한다 · J-101).
    teacher_changed 는 강사 교체 마법사(POST /ops/teacher-change · cplId)가 처음 채운다 — 접수 건은 그 순간 대응으로 옮기고 담당이 비어 있으면 돌린 사람이 된다.
    v4.25 (C86-d) — 이 줄은 한동안 「open | acting | done」이라 선언돼 있었고 표에는 제약이 없었다.
    저장되는 말은 처음부터 received | acting | closed 였는데, lib/exec-areas 의 컴플레인 판정이
    선언을 믿고 stage <> 'done' 으로 세는 바람에 **끝난 건까지 전부 세어** 대표 보고 배지가 8 이었다
    (열린 건은 5). 선언과 데이터가 다르면 그 차이를 읽은 쪽이 조용히 틀린다 — 이제 CHECK 가 막는다.
    기존 행 보정 0 (N-25): 다른 낱말이 있으면 마이그레이션이 **세어서 멈춘다**.'''
}

Table PLAN {
  id            bigserial   [pk]
  title         varchar(120)[not null]
  stage         varchar(12) [not null, note: 'v4.38 · draft | review | rework | approved | done — plan_stage_words CHECK (NOT VALID). 한동안 이 note 와 entity 주석이 둘 다 `ok` 라 적었다: 마이그레이션 1756700000000 이 ok·done 을 approved 로 접은 뒤였고 코드가 쓰는 낱말은 줄곧 approved 였다 (C86-d 와 같은 자리 — 선언과 데이터가 다르면 그 차이를 읽은 쪽이 조용히 틀린다)']
  goal          text
  tasks         jsonb
  research      text        [note: 'v4.38 이전에는 시드만 채웠다 — 읽기와 화면 칸은 있는데 쓰는 API 가 없어 §65 「3 · 리서치」가 영원히 「—」였다. PATCH /ops/plans/:id 가 적는다']
  ask           text        [note: '결정 요청']
  due_on        date
  owner_id      bigint      [ref: > STAFF.id]
  due_approved_at timestamptz [note: '기한 승인 도장(C56 · migration 1759100000000) — plan_due_approval_pair((due_approved_at IS NULL) = (due_approved_by IS NULL)) · plan_due_approval_needs_due(승인 도장은 기한이 있을 때만) 둘 다 NOT VALID. v4.54 에 W11 대조로 보탬(이전 판에 칸이 빠져 있었다)']
  due_approved_by bigint      [note: '기한을 승인한 사람(C56). DB 에 FK 없음 — W11 대조로 보탬']
  rework_reason text        [note: 'v4.38 · 보완 요청 사유 — **다시 올릴 때 지워진다**(C85-a 가 RPT 에서 정한 것과 같다: 지난 반려 사유가 남아 있으면 지금 상태를 속인다). log.after->>reason 에서 되짚지 않는다 — 사유는 지워지는 업무 상태이고 log 는 지워지지 않는 감사 줄이며, log.after 의 생김새는 계약이 아니다. 옛 행 NULL (N-25 · 보정 0)']
  share         varchar(10) [note: 'v4.54 · W11 N-72 — all 전체 공개 · picked 지정 공개(담당 · 지정된 사람(PLAN_PICK) · 결재권자) · NULL 옛 기획(모두에게 보이고 칩 없음 · 보정 0) · plan_share_words CHECK']
  due_rejected_on date      [note: 'v4.54 · W11 N-95 — 반려된 기한(반려가 지운 due_on 의 값) · §62 반려 줄 · 기한 반려 띠']
  due_rejected_at timestamptz [note: 'v4.54 · 기한을 반려한 순간']
  due_rejected_by bigint    [ref: > STAFF.id, note: 'v4.54 · 기한을 반려한 사람(plan_due_rejected_by_fk)']
  created_at    timestamptz [not null, default: `now()`]
  Note: '''시드 5건. 대표 결재 대기(stage='review') 수가 일일 보고의 판정 기준.
    v4.38 (S6): 단계를 옮기는 표는 lib/plan-words.PLAN_NEXT_STAGES 한 벌이다 —
    draft·rework → review(올린 쪽) · approved → done(올린 쪽) · **review → approved|rework 는 여기 없다**
    (대표의 결재이고 reviewPlan 이 자기 결재 금지·기한 승인 선행·사유 필수를 지나서 옮긴다 · C90 LEAD_NEXT_STAGES 와 같은 규약).
    「보완 N」 칩은 이 표가 아니라 LOG(entity='plan' · action='rework') 를 센다 — 횟수는 append-only 역사라 어긋날 수 없고 세는 칸을 파지 않는다.
    v4.54 · W11(migration 1764700000000 · N-72 · N-95): plan_due_rejected_triple(반려 셋은 함께 있거나 함께 없다) ·
    plan_due_rejected_clears(due_rejected_at IS NULL OR due_on IS NULL — 새 기한을 내면 반려 셋을 비운다). 기한 결정은 화면이 본 날짜(dueOn)를 함께 보내야 한다(PB-12-2).
    지정 공개면 PLAN_PICK 에 볼 사람을 적는다 — 판정은 planCan 한 곳이고 다섯 읽기(§61 · §62 · §65 · §69 · §75)가 지난다. 바꾸기는 담당 · 결재권자만(감사 줄 PLAN/share).'''
}

Table PLAN_PICK {
  plan_id  bigint [not null, ref: > PLAN.id, note: 'plan_pick_plan_fk · ON DELETE CASCADE']
  staff_id bigint [not null, ref: > STAFF.id, note: 'plan_pick_staff_fk']
  indexes {
    (plan_id, staff_id) [pk]
  }
  Note: 'v4.54 · W11 N-72 — 지정 공개(PLAN.share = picked) 기획을 볼 수 있게 지정된 사람 (CONS_PICK 과 같은 모양 · migration 1764700000000).'
}

Table MKT {
  id          bigserial   [pk]
  channel     varchar(20) [not null, note: 'v4.54 · W11 N-29 ① — kakao · naver_ad · instagram · naver_blog(원문 넷) + 옛 코드 naver · daangn · youtube · referral · flyer(읽기 전용 · 이관 없음) · mkt_channel_words CHECK NOT VALID. kakao 는 코드 그대로 표시만 「카카오채널」(A′ 판단 — 옛 행이 가리키던 것과 같다)']
  item        varchar(20) [not null, note: 'v4.54 · W11 N-29 ① — reply · ad · video · post(원문 넷) + 옛 코드 blog · biz · channel · word · print · mkt_item_words CHECK NOT VALID. ad · video 는 코드 그대로 표시만 원문 낱말']
  url         text
  result      jsonb
  on_date     date
  title       varchar(120) [note: '「오늘 한 것」 활동 이름(C53 · migration 1758900000000) — v4.54 에 W11 대조로 보탬(이전 판에 칸이 빠져 있었다)']
  by_id       bigint      [note: '활동을 적은 사람(C53). DB 에 FK 없음 — W11 대조로 보탬']
  memo        varchar(120) [note: 'v4.54 · W11 N-29 ② — 카드 제목 아래 메모 한 줄(MMEMO = MKT 의 한 칸 · D-R22) · 옛 행 NULL · migration 1764600000000']
  Note: '시드 4건.'
}

Table MFB {
  id          bigserial   [pk]
  mkt_id      bigint      [ref: > MKT.id]
  by_id       bigint      [not null, ref: > STAFF.id]
  body        text        [not null]
  at          timestamptz [not null, default: `now()`]
  kind        varchar(8)  [not null, default: 'comment', note: "comment(대표 코멘트) · reply(담당자 답변 · 고친 것 알리기) · hold(담당자 보류 · v4.54 · W11 N-29 ③) — mfb_kind_chk NOT VALID. 칸 자체는 C53(migration 1758900000000) — v4.54 에 W11 대조로 보탬"]
  parent_id   bigint      [note: "reply · hold 는 부모 코멘트를 든다 — mfb_reply_needs_parent ((kind IN ('reply','hold')) = (parent_id IS NOT NULL) · NOT VALID). 칸은 C53 · DB 에 자기 참조 FK 없음(짝 CHECK 만) — W11 대조로 보탬"]
  indexes {
    (mkt_id, at) [name: 'mfb_mkt_id_at_idx']
    parent_id [name: 'mfb_parent_id_idx']
    parent_id [unique, name: 'mfb_hold_once', note: "WHERE kind = 'hold' — 보류는 코멘트마다 한 번 (v4.54 · W11)"]
  }
  Note: '대표 피드백 — 코멘트하면 관리자 전원에게 알림. v4.54 · W11 N-29 ③(migration 1764600000000): 담당자 보류 hold — 보류한 카드는 「보류」 단추가 없고 보류 글 블록이 선다.'
}

Table MTREC {
  id          bigserial   [pk]
  mt_type     varchar(12) [not null, note: '기획 · 컨설팅 · 마케팅 · 개발 · 일반 5종']
  title       varchar(120)
  on_date     date
  pre_files   jsonb
  minutes     text        [note: '속기록']
  minutes_at  timestamptz [note: '속기록을 마지막으로 저장한 시각 — created_at(행이 생긴 시각)과 다른 값이다']
  minutes_by  bigint      [ref: > STAFF.id, note: '마지막으로 저장한 사람']
  created_at  timestamptz [not null, default: `now()`]
  ser_id      bigint      [ref: > SER.id, note: 'v4.35 · 그 회의가 놓인 시간표 회차 — 시각·강의실·온라인·겹침은 전부 SER/ser_occ 가 이미 갖는다 (ON DELETE SET NULL — 회차가 사라져도 속기록·참석은 기록으로 남는다 · mtrec_ser_once 부분 유니크 · 옛 행 NULL 보정 0 · N-25 · C96)']
  Note: '''
  시드 5건. 속기록 → 할 일 → 알림으로 퍼진다.
  TBO-48 C57 migration 1759200000000: mtrec_minutes_author_pair —
  저장 시각만 있고 저장한 사람이 없을 수는 없다((minutes_at IS NULL) = (minutes_by IS NULL)).
  '''
}

Table MTATTD { mt_id bigint [ref: > MTREC.id]  staff_id bigint [ref: > STAFF.id]  confirmed boolean  indexes { (mt_id, staff_id) [pk] } }

Table TODO {
  id          bigserial   [pk]
  title       varchar(160)[not null]
  from_id     bigint      [ref: > STAFF.id, note: '준 사람']
  to_id       bigint      [ref: > STAFF.id, note: '받은 사람']
  due_on      date
  done        boolean     [not null, default: false]
  src         todo_src_t  [not null, default: 'manual']
  mt_id       bigint      [ref: > MTREC.id]
  cpl_id      bigint      [ref: > CPL.id]
  cons_id     bigint      [ref: > CONS.id]
  plan_id     bigint      [ref: > PLAN.id]
  ser_id      bigint      [ref: > SER.id, note: '회차 지시 — §12 첫 줄 「대표 지시 할 일」']
  on_date     date        [note: '규칙이 원래 찍은 날(EXC 키). SER_OCC.id 를 쓰지 않는다 — 그 표는 쓰기마다 다시 만들어지는 투영이다']
  lead_id     bigint      [ref: > LEAD.id, note: 'v4.54 · W11 N-86 — 사후 관리 할 일이 걸린 상담 건(todo_lead_id_fk · ON DELETE CASCADE · 제품에 지우는 길 없음)']
  care        varchar(12) [note: 'v4.54 · W11 N-86 — happycall(첫 실제 수업 + 7일) | monthly(첫 수업과 같은 날 매월 · 없으면 말일) · todo_care_words CHECK NOT VALID']
  created_at  timestamptz [not null, default: `now()`]
  indexes {
    (ser_id, on_date) [name: 'todo_lesson_idx']
    lead_id [name: 'todo_lead_idx', note: 'WHERE lead_id IS NOT NULL']
    lead_id [unique, name: 'todo_lead_happycall_once', note: "WHERE care = 'happycall' — 해피콜은 상담 건마다 하나"]
    (lead_id, due_on) [unique, name: 'todo_lead_monthly_on', note: "WHERE care = 'monthly' — 같은 날 월간 하나 (등록 재시도 중복 0 · S13)"]
  }
  Note: '''
  시드 4건. 출처 필드로 원본을 되짚을 수 있다.
  `src='lesson'` 이면 `(ser_id, on_date)` 가 함께 있어야 한다 (`todo_lesson_key` · NOT VALID).
  회차 키가 둘인 이유는 회차의 정체가 그 짝이기 때문이다 (C82-b 원장).
  v4.54 · W11 N-86(migration 1764600000000): todo_lead_key — ((src)::text = 'lead') = (lead_id IS NOT NULL) AND (lead_id IS NULL) = (care IS NULL) · NOT VALID.
  등록 확정 트랜잭션이 해피콜 · 첫 월간을 상담 담당에게 만들고(ops/lead-care planLeadCare), 월간을 끝내면 같은 트랜잭션에서 다음 달 하나(continueLeadCare — 휴원 복귀 뒤 · 수강 종료 멈춤).
  끝낸 사후 관리(src=lead)는 서랍 「끝난 것 지우기」가 지우지 않는다(lib/todo TODO_KEEP_ON_CLEAR · 완료 이력 보존 · A′ 후속) · 서랍 「원본」은 /intake?lead=<id>.
  W11 O(칸 변경 0): 수업 상세 「+ 할 일」이 회차 키(ser_id, on_date)를 싣는다(POST /drawer/todos +serId · onDate).
  '''
}

Table REQ {
  id          bigserial   [pk]
  staff_id    bigint      [not null, ref: > STAFF.id, note: '강사가 올린다']
  req_type    varchar(16) [not null, note: 'CHECK 없음 — 강사 요청 넷 wage_change · tz_change · book_change · gpa_request(teacher.dto TEACHER_REQ_TYPES · 뒤 둘은 v4.54 · W11 N-99) · 옛 낱말 unav_add · doc(REQ_TYPE_LABEL). 낱말은 lib/approval 한 곳']
  payload     jsonb
  state       varchar(12) [not null, default: 'pending', note: 'pending → approved | rejected. v4.54 · W11 대조로 DB 기본값에 맞춤 — 이전 판은 open 이라 적었으나 migration 1756700000000-approval-state-words 가 기본값을 pending 으로 바꾼 뒤였다']
  resolved_by bigint      [ref: > STAFF.id]
  reject_reason text      [note: '반려 시 필수 (D-R13)']
  student_id  bigint      [ref: > STU.id, note: '교재 변경 · GPA 회차 요청이 가리키는 학생(req_student_id_fkey · C77 migration 1759700000000 · 옛 행 NULL). v4.54 에 W11 대조로 보탬(이전 판에 칸이 빠져 있었다)']
  created_at  timestamptz [not null, default: `now()`]
  Note: '''
  시드 6건. 승인 대기함에 모인다. 승인 결과는 LOG + NOTI.
  v4.54 · W11(칸 변경 0 · N-99 · §14): 강사가 교재 변경 · GPA 회차 요청을 올린다. 결재 처리는 「되돌리기」로 취소된다 — 토큰은 결재 줄에 묶이고 LOG 에 REQ / undo · CHREQ / undo · ZACC / update 가 새로 남는다(감사 낱말은 이제부터 대문자 · 리드 결정).
  '''
}

Table NOTI {
  id          bigserial   [pk]
  to_id       bigint      [not null, ref: > STAFF.id]
  from_id     bigint      [ref: > STAFF.id]
  title       varchar(80) [note: '§16 카드의 굵은 제목 (v4.44 · g2 16-1). 옛 행·제목을 안 적는 쓰기는 null — 화면은 본문만 그린다']
  body        text        [not null]
  link        varchar(80)
  category    varchar(20) [not null, default: 'etc', note: '작성 독촉 · 재알람 · 리포트 · 일정 변경 · 요청 처리 · 기타. C76 migration 32 CHECK']
  request_key uuid        [note: '§47 독촉 HTTP 재시도 키. 기존/다른 알림은 null']
  request_teacher_id bigint [note: '§47 요청 범위 스냅샷. null=전체, 값=명시 강사 ID']
  read_at     timestamptz
  created_at  timestamptz [not null, default: `now()`]
  indexes { (request_key, to_id) [unique, note: 'request_key IS NOT NULL partial unique'] }
  Note: '시드 8건. 인앱 구현 완료 · category가 §16 분류 정본이며 링크 파생은 과거 행 fallback뿐 · 카카오/알림톡 실발송은 아직 없음 (D9).'
}

Table LOG {
  id          bigserial   [pk]
  actor_id    bigint      [not null, ref: > STAFF.id]
  entity      varchar(20) [not null]
  entity_id   bigint      [not null]
  action      varchar(20) [not null]
  before      jsonb
  after       jsonb
  at          timestamptz [not null, default: `now()`]
  indexes { (entity, entity_id, at) }
  Note: '시드 4건.'
}

Table RPT {
  id          bigserial   [pk]
  rpt_type    varchar(8)  [not null, note: 'day | week | month (v2 — 3주기)']
  on_date     date        [not null, note: 'day=그날 · week=그 주 월요일 · month=YYYY-MM-01 로 정규화 (D-R23)']
  memo        jsonb       [not null, note: '영역별 한 줄. 하나도 안 적으면 제출 불가 (D-R14)']
  state       varchar(8)  [not null, default: 'draft', note: 'draft | sent | ok | rej']
  sent_at     timestamptz
  reviewed_at timestamptz
  reject_reason text
  sent_by     bigint      [ref: > STAFF.id, note: '올린 사람 — 원본 §69 서명줄. ON DELETE RESTRICT (v4.24)']
  reviewed_by bigint      [ref: > STAFF.id, note: '대표 승인 — 원본 §69 서명줄. ON DELETE RESTRICT (v4.24)']
  indexes { (rpt_type, on_date) [unique] }
  Note: '''
  시드 1건. 내용은 저장하지 않고 각 엔티티에서 실시간 집계한다 (D-3 · D-R24).
  rpGather(kind,d1,d2) 가 전부 계산하고 여기에는 st/memo/sign 만 남는다.
  6개 영역 순서 고정 (D-R25) — 회계(INV·PAY) → 마케팅(MKT·MFB) → 운영(PLAN·TODO·SER)
             → 컨설팅(CONS) → 컴플레인(CPL) → 수업(SER+clChk). 스케줄 변동은 제외.
  월간은 손익(매출−강사료−지출)과 상담 퍼널(stopAt)이 더 붙는다.
  (rpt_type, on_date) unique 로 같은 달 보고서 중복 생성을 막는다 (D-R23).
  v4.54 · W11(칸 변경 0): 영역 메모 칸 위의 담당은 EXEC_AREA_OWNER 에서 읽는다(N-81 · 슬라이드 72). 응답 ExecReportDto 는 memo(6영역 메모의 JSON 글자)를 빼고 memos 만 싣는다(7-3 ② · RPT.memo 칸은 그대로).
  회수(N-97 · POST /exec/report/:id/withdraw)는 올린 사람만 · 올라간 보고만 sent → draft 로 되돌리고 서명을 비운다 — 감사 줄 RPT/withdraw.
  '''
}

Table EXEC_AREA_OWNER {
  area_key varchar(12) [pk, note: 'money · mkt · ops · consulting · complaint · lesson — exec_area_owner_key_words CHECK (D-R25 여섯 영역)']
  staff_id bigint      [ref: > STAFF.id, note: 'exec_area_owner_staff_fk · ON DELETE SET NULL · NULL = 비움']
  set_by   bigint      [not null, ref: > STAFF.id, note: 'exec_area_owner_set_by_fk · 정한 사람']
  set_at   timestamptz [not null, default: `now()`]
  Note: 'v4.54 · W11 N-81(슬라이드 72 · migration 1764700000000) — 대표 보고 영역마다 고정 담당 한 명. 대표가 정한다(canCeoSetExecOwner · 감사 줄 EXEC_AREA/owner). 처음엔 비어 있다 — 시드가 넣지 않는다.'
}

Table PDFLOG {
  id          bigserial   [pk]
  kind        varchar(16) [not null]
  ref_id      bigint
  file_url    text
  at          timestamptz [not null, default: `now()`]
  rep_id      bigint      [ref: > REP.id, note: 'v4.54 · W11 7-3 ① — 보존한 리포트 PNG 한 장이 어느 리포트의 것인지(pdflog_rep_id_fkey). 발송 · 재발송이 적는다 · 옛 행 NULL(N-25 — 읽는 쪽은 묶음 전체로 판정) · migration 1764400000000']
  indexes {
    (kind, ref_id, at) [name: 'pdflog_kind_ref_at_idx', note: 'at DESC — W11 대조로 보탬(이전 판에 없던 기존 색인)']
    rep_id [name: 'pdflog_rep_idx', note: 'WHERE rep_id IS NOT NULL']
  }
}

// ─────────────────────────────────────────────────────────────── 강사 전용 (v26)

Table SUGGESTION {
  id          bigserial   [pk]
  staff_id    bigint      [not null, ref: > STAFF.id]
  category    sug_cat_t   [not null, note: '수업 · 시급 · 스케줄 · 기타 (D-11 확정)']
  body        text        [not null]
  state       sug_state_t [not null, default: 'open', note: '접수됨 · 확인 중 · 답변 완료 (D-12)']
  reply       text
  reply_by    bigint      [ref: > STAFF.id]
  reply_at    timestamptz
  created_at  timestamptz [not null, default: `now()`]

  indexes { (staff_id, created_at) }
  Note: '''
  강사 백오피스 전용. 관리자 명세서에 없다 — v26 이 정본.
  월 3회 제한. 시급·정산 문의는 관리자만 확인하며 다른 강사에게 공개되지 않는다.
  '''
}

Table NOTE {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id, note: 'note_student_fk · RESTRICT (v4.54 M2)']
  ser_id      bigint      [ref: > SER.id, note: 'note_ser_fk · RESTRICT (v4.54 M2)']
  author_id   bigint      [not null, ref: > STAFF.id, note: 'FK 없음 — 계정 참조 목록(lib/staff-refs STAFF_SOFT_REFS)이 관리한다']
  body        text        [not null, note: 'CHECK note_body_present — length(btrim(body)) > 0 AND length(body) <= 2000 (쓰기 경로는 500자 · v4.54 M2)']
  created_at  timestamptz [not null, default: `now()`]
  indexes { (student_id, created_at) }
  Note: '인수인계 메모(N-36 ② · v4.54 M2 · migration 1764900000000) — 관리자 · 매니저가 §79 학생 트래킹에서 한 줄씩 더하고(고치기 · 지우기 없음) 그 학생을 맡은 강사가 수업 안내 학생 카드에서 읽는다. 학부모에게 나가지 않는다.'
}

Table DIAG {
  id          bigserial   [pk]
  student_id  bigint      [not null, ref: > STU.id]
  ser_id      bigint      [ref: > SER.id]
  level_summary text      [not null]
  strengths   text
  weaknesses  text
  curriculum  text
  created_by  bigint      [not null, ref: > STAFF.id]
  created_at  timestamptz [not null, default: `now()`]
  Note: '진단 리포트. 수업 안내 화면에 요약이 뜬다. 코디네이터와 공유.'
}

// ─────────────────────────────────────────────────────────── GPA (v2 §14)
// N-13 채택 (2026-09-12 §4-17 ①) — 「표로 뺀다」 안 그대로 확정.
// migration 1758300000000 (C34 · 구 M2) 로 4표가 실제 스키마에 합류했다.
// CHECK: point>0 · alloc points≥0 · use points>0 · state IN(wait,ok) · from<to.

Table GPASVC {
  key         varchar(8)  [pk, note: 'hw · prj · quiz · test · self']
  name        varchar(30) [not null]
  point       smallint    [not null, note: '1 · 2 · 2 · 4 · 6']
  color       char(7)
  sort        smallint
  Note: 'GPA 서비스 5종. 회차마다 이 포인트가 배정량에서 깎인다 (D-R29).'
}

Table GPA_CYCLE {
  id          bigserial [pk]
  no          smallint  [not null, note: '3차 사이클 …']
  from_date   date      [not null]
  to_date     date      [not null, note: '4주']
  closed      boolean   [not null, default: false]
  closed_at   timestamptz [note: 'v4.33 · 마감 시각 — POST /gpa/cycles/{id}/close 가 찍는다. 시드가 켠 옛 닫힘은 NULL (N-25)']
  closed_by   bigint    [ref: > STAFF.id, note: 'v4.33 · 마감한 사람 (ON DELETE RESTRICT · closed_at 과 짝 — gpa_cycle_closed_pair · 찍혔으면 closed — gpa_cycle_closed_stamp)']
  indexes { (from_date, to_date) }
  Note: '''
  4주 사이클. 이월 없음 — 닫히면 잔여 포인트는 소멸한다 (D-R29).
  v4.33 (C95 · O-150 「4주마다 — GPA 사이클 마감」) — 마감은 열려 있고 · 끝날이 지났고 · 승인 대기가 0 일 때만(끝나기 전에 닫으면 남은 날의 기록을 적을 사이클이 없다).
  잔여는 board() 와 같은 셈(배정 − 승인 사용)이 그대로 소멸 포인트다. 뒤에 사이클이 없으면 끝날 다음 날부터 4주를 연다 · LOG(GPA_CYCLE close).
  '''
}

Table GPA_ALLOC {
  id          bigserial [pk]
  cycle_id    bigint    [not null, ref: > GPA_CYCLE.id]
  student_id  bigint    [not null, ref: > STU.id]
  coord_id    bigint    [ref: > STAFF.id, note: '담당 코디네이터']
  points      smallint  [not null, note: '이 사이클 배정량']
  indexes { (cycle_id, student_id) [unique] }
  Note: '학생별 배정. gpaByStudent() = 배정 − 사용 − 대기.'
}

Table GPA_USE {
  id          bigserial   [pk]
  cycle_id    bigint      [not null, ref: > GPA_CYCLE.id]
  student_id  bigint      [not null, ref: > STU.id]
  ser_id      bigint      [ref: > SER.id, note: "kind='gpa' 회차"]
  svc_key     varchar(8)  [not null, ref: > GPASVC.key]
  points      smallint    [not null, note: 'GPASVC.point 스냅샷']
  on_date     date        [not null]
  start_min   smallint
  coord_id    bigint      [ref: > STAFF.id]
  note_url    text        [note: '기록지']
  state       varchar(8)  [not null, default: 'wait', note: 'wait | ok — 대기는 타임라인에 점선']
  approved_by bigint      [ref: > STAFF.id, note: 'v4.36 · 승인한 사람 (ON DELETE RESTRICT · approved_at 과 짝 — gpa_use_approve_pair). 되돌리면(wait) 둘 다 지운다. v4.39 — 「적은 사람과 달라야 한다」(gpa_use_no_self_approve)는 대표 결정 2026-09-21 로 내렸다. 도장은 그대로 남는다']
  approved_at timestamptz [note: 'v4.36 · 승인 시각 — PATCH /gpa/uses/{id} state=ok 가 찍는다. 옛 승인 행은 NULL (N-25 · 보정 0)']
  indexes { (cycle_id, student_id, on_date) (approved_by) }
  Note: '''
  회차별 소비. ptOf() 가 읽고 gpTimeline() 이 날짜·시간순으로 잔여 막대를 그린다.
  배정을 넘기면 붉게 표시하고 추가 결제 또는 다음 사이클 조정을 안내한다.
  학부모 비공개 — 내부 자료로만 쓴다 (D-R30).
  v4.36 (S1) — 이 경로는 2026-09-20 전까지 **누가 승인했는지 받지도 않아** 자기 기록을 자기가 승인할 수 있었다.
  '''
}

Table SER_OCC {
  id          bigserial [pk]
  ser_id      bigint    [not null, ref: > SER.id]
  on_date     date      [not null]
  teacher_id  bigint    [ref: > STAFF.id]
  room_id     bigint    [ref: > ROOM.id]
  zacc_id     bigint    [ref: > ZACC.id]
  canceled    boolean   [not null, default: false]
  span        tstzrange [not null]

  indexes {
    (ser_id, on_date) [unique, name: 'ser_occ_ser_date_uniq']
  }

  Note: '''
  전개된 회차. 반복 규칙(SER)은 기간이 열려 있어 겹침 제약을 걸 대상이 없으므로,
  occ() 와 같은 규칙으로 회차를 펼쳐 이 표에 넣고 **여기에** EXCLUDE 를 건다 (D-R43 · 부록 A).
  span 은 tstzrange(start_at, end_at) 이고, canceled=true 인 회차는 제약에서 빠진다.
  위 제외는 EXCLUDE만 해당한다. ser_occ_time_check는 취소 포함 유한 [start,end), 정수 분/10~480분·KST당일(끝24:00 허용)을 검사한다. 이동 회차의 on_date와 표시 날짜는 같을 필요 없다.
  강의실 · 강사 · 줌 세 제약이 전부 이 표에 붙는다 — 최종 방어선이 여기다.
  '''
}

// ============================================================================
// 아직 표를 만들지 않은 것 — docs/decisions/PLANNING-REQUIRED.md
//   N-13 GPA 저장 위치 → 위 GPA_* 4표를 채택할지 SER 에 얹을지
//   N-14 이름을 키로 쓰는 5곳(ISSUE.stu/.ins · GUIDE.stu/.ins · INV.stu · SER.ins/.stu)
//        을 언제 id 참조로 바꾸나 — 서버에서 동명이인·개명에 깨진다
//   N-15 학생 「이 회차만 빼기」에 「향후」 범위를 줄 것인가 → EXC_STU_OUT 에 to_date
