// v4.89 → v4.90 (2026-10-09 · TBO-55 BOC-11F 권고안 채택) — 교재 판매·결제 수단별 수수료와 취소 보정 원장.
//   + BOOK_SALE_FEE_POLICY — transfer/cash별 fixed/rate_bps, version, 효력기간 immutable 정책.
//   + BOOK_SALE — LIB/VERS 표시 snapshot, 서버 계산 합계·수수료·순수납, 원 PAY와 취소 보정 PAY current.
//   + BOOK_SALE_REQUEST/EVENT — UUID 멱등 요청, actual actor, expected/result version과 append-only 상태·금액 receipt.
//   + 기간 EXCLUDE, current/event receipt, completed→canceled 단일 전이, policy/PAY/audit immutable·직접 PAY 삭제 방어.
//   + 표 +4(140 → 144) · migration 1(1768700000000-book-sales) · 운영 미적용.

Table BOOK_SALE_FEE_POLICY {
  id bigint [pk, increment]
  payment_method varchar(16) [not null, note: 'transfer | cash']
  calculation varchar(12) [not null, note: 'fixed | rate_bps']
  value int [not null, note: 'fixed는 원/건, rate_bps는 1/10000 비율']
  policy_version int [not null]
  effective_from date [not null]
  effective_to date
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_method, policy_version) [unique, name: 'book_sale_fee_policy_version_unique']
    (payment_method, effective_from, policy_version) [name: 'book_sale_fee_policy_lookup_idx']
  }
}

Table BOOK_SALE {
  id bigint [pk, increment]
  student_id bigint [not null]
  book_id bigint [not null]
  book_code varchar(30) [not null]
  book_title varchar(120) [not null]
  book_edition varchar(80)
  book_label varchar(260) [not null, note: '판매 당시 교재 표시 snapshot']
  sold_on date [not null]
  quantity int [not null]
  unit_price int [not null]
  total_amount int [not null]
  payment_method varchar(16) [not null, note: 'transfer | cash']
  fee_policy_id bigint [not null]
  fee_policy_version int [not null]
  fee_amount int [not null]
  net_amount int [not null]
  pay_id bigint [not null, unique, note: 'invoice 없는 원 판매 PAY']
  correction_pay_id bigint [unique, note: '취소 시 현재 열린 월의 음수 보정 PAY']
  status varchar(12) [not null, note: 'completed | canceled']
  row_version int [not null]
  memo varchar(500)
  created_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  canceled_by bigint
  canceled_at timestamptz
  cancel_reason varchar(500)

  indexes {
    (sold_on, id) [name: 'book_sale_ledger_idx']
    (student_id, sold_on, id) [name: 'book_sale_student_idx']
  }
}

Table BOOK_SALE_REQUEST {
  request_key uuid [pk]
  actor_id bigint [not null]
  action varchar(12) [not null, note: 'created | canceled']
  sale_id bigint [not null]
  expected_version int [not null]
  payload_sha256 char(64) [not null]
  result_version int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (sale_id, created_at) [name: 'book_sale_request_sale_idx']
  }
}

Table BOOK_SALE_EVENT {
  id bigint [pk, increment]
  sale_id bigint [not null]
  action varchar(12) [not null, note: 'created | canceled']
  from_status varchar(12)
  to_status varchar(12) [not null]
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  result_version int [not null]
  total_amount int [not null]
  fee_amount int [not null]
  net_amount int [not null]
  pay_id bigint [not null]
  correction_pay_id bigint
  reason varchar(500)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (sale_id, result_version) [unique, name: 'book_sale_event_version_unique']
    (sale_id, created_at, id) [name: 'book_sale_event_sale_idx']
  }
}

