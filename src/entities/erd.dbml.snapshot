Ref: PAYOUT_DISBURSEMENT_EVENT.account_id > PROTECTED_ACCOUNT.id [delete: restrict]

// v4.84 → v4.85 (2026-10-09 · TBO-55 BO-11BD-01 권고안 채택) — 청구 조정 신청과 승인 상태·금액·감사 이력.
//   + INVOICE_ADJUSTMENT_BASE — 첫 신청 시점의 INV 원금 snapshot. UPDATE/DELETE를 금지한다.
//   + INVOICE_ADJUSTMENT — 신청 identity와 pending/approved/rejected/canceled current, actual actor·version·사유·시각.
//   + INVOICE_ADJUSTMENT_EVENT — UUID requestKey·payload hash·결과 version과 전이 전후 INV amount를 append-only 보존한다.
//   + deferred receipt/합계/초과납부 guard — current와 event가 일치하고 INV.amount=원금-approved 합계이며 승인 없는 초과 수납을 거절한다.
//   표 +3(124 → 127) · migration 1(1768200000000-invoice-adjustment) · 운영 미적용.

Table INVOICE_ADJUSTMENT_BASE {
  inv_id bigint [pk]
  original_amount int [not null, note: '첫 조정 요청 시 고정한 비음수 INV 원금']
  created_at timestamptz [not null, default: `now()`]
}

Table INVOICE_ADJUSTMENT {
  id bigint [pk, increment]
  inv_id bigint [not null]
  student_id bigint [not null]
  year_month char(7) [not null]
  effective_on date [not null]
  kind varchar(24) [not null, note: 'discount | refund | sibling_discount | carry']
  reason varchar(500) [not null]
  amount int [not null, note: '승인 시 현재 청구액에서 차감할 양의 원 금액']
  state varchar(16) [not null, default: 'pending', note: 'pending | approved | rejected | canceled']
  row_version int [not null, default: 1]
  requested_by bigint [not null]
  requested_at timestamptz [not null, default: `now()`]
  decided_by bigint
  decided_at timestamptz
  reject_reason varchar(200)
  canceled_by bigint
  canceled_at timestamptz
  cancel_reason varchar(200)
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (year_month, state, effective_on, id) [name: 'invoice_adjustment_month_state_idx']
    (inv_id, requested_at, id) [name: 'invoice_adjustment_invoice_idx']
    (student_id, year_month, id) [name: 'invoice_adjustment_student_idx']
  }
}

Table INVOICE_ADJUSTMENT_EVENT {
  id bigint [pk, increment]
  invoice_adjustment_id bigint [not null]
  action varchar(20) [not null, note: 'created | approved | rejected | canceled | restored']
  from_state varchar(16)
  to_state varchar(16) [not null]
  reason varchar(200)
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  payload_sha256 char(64) [not null]
  result_version int [not null]
  invoice_amount_before int [not null]
  invoice_amount_after int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_adjustment_id, result_version) [unique, name: 'invoice_adjustment_event_version_unique']
    (invoice_adjustment_id, result_version, id) [name: 'invoice_adjustment_event_item_idx']
  }
}

