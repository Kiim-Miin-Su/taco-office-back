// v4.85 → v4.86 (2026-10-09 · TBO-55 BOC-11C 권고안 채택) — 연체 후보 정책과 수강 정지 current/event 원장.
//   + DELINQUENCY_POLICY/EVENT — 기본 14일 후보 기준의 current와 실제 actor·멱등 변경 이력.
//   + DELINQUENCY_SUSPENSION/EVENT — 학생별 suspended/released current와 독촉·정지·해제 snapshot 불변 이력.
//   + 일정 guard — 기존 일정은 보존하고 SER_STU 확대, SER 시간 확대·이동, EXC 복원·이동의 직접 SQL을 차단한다.
//   표 +4(127 → 131) · migration 1(1768300000000-delinquency-suspension) · 운영 미적용.

Table DELINQUENCY_POLICY {
  id smallint [pk, note: '전역 정책 단일 행 id=1']
  threshold_days int [not null, default: 14, note: '1~365일. 후보 기준이며 자동 정지는 하지 않는다']
  row_version int [not null, default: 1]
  updated_by bigint
  updated_at timestamptz [not null, default: `now()`]
}

Table DELINQUENCY_POLICY_EVENT {
  id bigint [pk, increment]
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  payload_sha256 char(64) [not null]
  threshold_before int [not null]
  threshold_after int [not null]
  result_version int [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table DELINQUENCY_SUSPENSION {
  student_id bigint [pk]
  state varchar(12) [not null, note: 'suspended | released']
  row_version int [not null]
  threshold_snapshot int [not null]
  overdue_days_snapshot int [not null]
  outstanding_snapshot bigint [not null]
  suspended_by bigint [not null]
  suspended_at timestamptz [not null]
  suspend_reason varchar(200) [not null]
  released_by bigint
  released_at timestamptz
  release_reason varchar(200)
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (state, student_id) [name: 'delinquency_suspension_state_idx']
  }
}

Table DELINQUENCY_SUSPENSION_EVENT {
  id bigint [pk, increment]
  student_id bigint [not null]
  action varchar(12) [not null, note: 'reminded | suspended | released']
  from_state varchar(12)
  to_state varchar(12)
  actor_id bigint [not null]
  request_key uuid [not null, unique]
  payload_sha256 char(64) [not null]
  result_version int [not null]
  overdue_days int [not null]
  outstanding bigint [not null]
  affected_series_count int [not null]
  reason varchar(200)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, result_version) [unique, name: 'delinquency_state_event_version_unique', note: '정지·해제 action에만 적용하는 partial unique index']
    (student_id, created_at, id) [name: 'delinquency_event_student_idx']
  }
}

Ref: DELINQUENCY_POLICY.updated_by > STAFF.id [delete: restrict]
Ref: DELINQUENCY_POLICY_EVENT.actor_id > STAFF.id [delete: restrict]
Ref: DELINQUENCY_SUSPENSION.student_id > STU.id [delete: restrict]
