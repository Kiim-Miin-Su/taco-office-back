# ── 데이터베이스 ────────────────────────────────
#    Neon 콘솔 > Connection Details > Pooled connection 문자열을 붙여 넣으세요.
DATABASE_URL="postgresql://…-pooler.…neon.tech/…?sslmode=require"

# ── 인증 (JWT · D-R41) ─────────────────────────
JWT_SECRET="openssl rand -base64 48 로 만든 값을 붙여 넣으세요"
JWT_EXPIRES="15m"
JWT_REFRESH_SECRET="위와 다른 값으로 한 번 더 만들어 붙여 넣으세요"
JWT_REFRESH_EXPIRES="14d"

# ── 문자 인증 (Naver Cloud SENS) ────────────────
#    taco-example/.env.local 의 값을 그대로 옮기세요. 발신번호 승인 완료 상태입니다.
SENS_SERVICE_ID=""
SENS_ACCESS_KEY=""
SENS_SECRET_KEY=""
SENS_FROM=""

# ── 메일 (Google SMTP) ─────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── 파일 저장소 (Vercel Blob · D-R42) ───────────
#    Vercel 대시보드 > Storage > Blob 에서 스토어를 만들면 자동으로 주입됩니다.
BLOB_READ_WRITE_TOKEN=""

# ── 줌 계정 암호화 (DEV-SPEC §3.1) ──────────────
ZOOM_ENC_KEY="openssl rand -hex 32 로 만든 값을 붙여 넣으세요"

# ── 로깅 ───────────────────────────────────────
LOG_LEVEL="debug"
LOG_PRETTY="true"

# ── 그 밖 ──────────────────────────────────────
PORT="3001"
CORS_ORIGIN="http://localhost:3000"
