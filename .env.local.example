# @file-guide
# 목적: .env.local.example (config)
# 책임/재사용: 기존 런타임/빌드/검사 설정을 유지한다. 의존성·배포·비밀값 변경은 별도 근거와 검증 없이는 추가하지 않는다.
# 검증/작업 지침: docs/contracts/FILE-GUIDE.md · docs/AGENT.md · docs/CLAUDE.md

# ══════════════════════════════════════════════════════════════════
#  개발용 — 이 파일을 `.env.local` 로 복사해서 값을 채우세요.
#  운영 값은 여기 적지 않습니다. `.env.production.example` 을 보세요.
# ══════════════════════════════════════════════════════════════════

# ── 데이터베이스 ────────────────────────────────
#    ./scripts/dev-db.sh up 을 돌리면 아래 두 줄이 자동으로 맞춰집니다.
DATABASE_URL="postgresql://taco:taco@localhost:55432/taco_dev"
# 표를 비우는 테스트 전용 — 개발 DB 와 반드시 달라야 합니다 (test/db.ts 안전벨트가 검사)
TEST_DATABASE_URL="postgresql://taco:taco@localhost:55432/taco_dev_test"

# ── 인증 (JWT) ─────────────────────────────────
#    openssl rand -base64 48
JWT_SECRET="dev-only-secret-not-for-production-0001"
JWT_REFRESH_SECRET="dev-only-refresh-secret-not-for-prod-02"
JWT_EXPIRES="15m"
JWT_REFRESH_EXPIRES="14d"

# ── 프런트 주소 · 쿠키 ──────────────────────────
CORS_ORIGIN="http://localhost:3000"
# 로컬은 비워 둡니다. localhost 에 Domain 을 주면 브라우저가 쿠키를 버립니다.
COOKIE_DOMAIN=""

# ── 그 밖 ──────────────────────────────────────
PORT="3001"
LOG_LEVEL="debug"
NODE_ENV="development"

# ── 아직 안 쓰는 것 (자리만) ────────────────────
#    문자 인증 · 메일 · 파일 · 줌 암호화는 해당 기능을 켜는 청크에서 채웁니다.
SENS_SERVICE_ID=""
SENS_ACCESS_KEY=""
SENS_SECRET_KEY=""
SENS_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
BLOB_READ_WRITE_TOKEN=""
ZOOM_ENC_KEY=""

# ── 계정 첫 설정 (W8 · 2026-09-26) ─────────────────
#  비우면 코드 기본값. AUTH_CODE_SECRET 을 비우면 (개발에서만) JWT_SECRET 으로 코드를 해시한다 — 운영은 반드시 따로 둔다(N-105).
TACO_INITIAL_PASSWORD=""
AUTH_CODE_SECRET=""
#  발송 설정(SMTP · SENS)이 없는 로컬에서 첫 설정을 끝까지 시험할 때만 on — 코드 응답에 「개발용 코드」가 실린다.
#  운영(NODE_ENV=production)에서는 무시된다.
AUTH_CODE_DEV_ECHO=""
