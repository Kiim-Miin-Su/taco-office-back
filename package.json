{
  "name": "taco-office-back",
  "version": "0.1.0",
  "private": true,
  "description": "TACO ERP API — NestJS 11 · TypeORM · Neon Postgres",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "openapi:gen": "ts-node -P tsconfig.json scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:gen -- --check",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed": "ts-node -P tsconfig.json scripts/seed.ts",
    "db": "./scripts/dev-db.sh",
    "db:doctor": "./scripts/dev-db.sh doctor",
    "schema:check": "ts-node -P tsconfig.json scripts/schema-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "depCheck": {
    "runtime": {
      "@nestjs/platform-express": "NestFactory 가 기본 어댑터로 이름을 보고 찾는다",
      "pg": "TypeORM 이 드라이버를 문자열(type:\"postgres\")로 찾는다",
      "passport": "@nestjs/passport 의 peer — 직접 import 하지 않는다",
      "rxjs": "Nest 의 peer — 데코레이터와 인터셉터가 내부에서 쓴다",
      "class-transformer": "ValidationPipe({transform:true}) 가 내부에서 쓴다",
      "reflect-metadata": "main.ts · data-source.ts 에서 부작용 import"
    },
    "tooling": {
      "@nestjs/cli": "nest build · nest start",
      "typescript": "tsc",
      "ts-node": "migration · seed · openapi 생성",
      "jest": "npm test",
      "ts-jest": "jest 트랜스폼",
      "eslint": "npm run lint",
      "prettier": "포맷",
      "embedded-postgres": "scripts/dev-db.sh — 이 컴퓨터에 Postgres 가 없어도 진짜 엔진을 띄운다",
      "@types/bcrypt": "타입만",
      "@types/cookie-parser": "타입만",
      "@types/express": "타입만",
      "@types/jest": "타입만",
      "@types/node": "타입만",
      "@types/passport-jwt": "타입만",
      "@types/supertest": "타입만"
    }
  }
}
