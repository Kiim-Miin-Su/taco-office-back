# ══════════════════════════════════════════════════════════════════
#  운영 (Vercel) — **이 파일에 값을 적지 마세요.**
#
#  값은 Vercel 대시보드에서 넣습니다:
#     프로젝트 > Settings > Environment Variables > Production
#  파일에 적으면 저장소에 들어가고, 저장소에 들어간 비밀값은 되돌릴 수 없습니다
#  (지워도 히스토리에 남습니다 — 키를 새로 발급해야 합니다).
#
#  넣고 나서 `npm run deploy:check` 로 확인하세요.
# ══════════════════════════════════════════════════════════════════

# ── 반드시 필요 ────────────────────────────────

#  Neon 콘솔 > Connection Details > **Pooled connection** (`-pooler` 가 붙은 쪽)
#  서버리스는 인스턴스가 수십 개로 늘어나므로 풀러를 거쳐야 커넥션이 안 터집니다.
DATABASE_URL=

#  각각 다른 값으로. openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

#  프런트 주소. 여러 개면 쉼표로.  예: https://app.tn.kr
CORS_ORIGIN=

#  ★ 로그인 유지 — 둘 중 하나는 **반드시** 채워야 합니다.
#     안 채우면 부팅이 실패합니다 (조용히 지나가지 않게 일부러 그렇게 했습니다).
#
#  ── ① 도메인이 있을 때 (권장) ─────────────────────────────
#     프런트  https://app.tn.kr      →  COOKIE_DOMAIN=".tn.kr"   ← 앞의 점 포함
#     API     https://api.tn.kr
#     둘이 같은 사이트가 되어 쿠키가 1st-party 로 실립니다. 브라우저 정책과 무관하게 계속 갑니다.
COOKIE_DOMAIN=

#  ── ② 도메인이 아직 없을 때 (임시) ────────────────────────
#     `taco-app.vercel.app` · `taco-api.vercel.app` 처럼 남남인 주소 두 개로 먼저 띄웁니다.
#     쿠키가 SameSite=None 으로 나가고 **지금은 동작합니다.**
#     다만 브라우저가 서드파티 쿠키를 막기 시작하면 그날로 로그인 유지가 끊깁니다.
#     도메인을 사시면 위 ①로 옮기고 이 줄을 지우세요 — **코드는 안 바뀝니다.**
COOKIE_CROSS_SITE=false

NODE_ENV=production

# ── 선택 ───────────────────────────────────────

#  운영에서 Swagger 문서를 열어 둘지. 기본은 닫힘 —
#  계약 파일(openapi.json)은 빌드 때 생성하므로 이것과 무관합니다.
ENABLE_DOCS=false

#  커넥션 풀 상한. Vercel 에서는 자동으로 1 입니다. 상시 서버로 옮기면 5~10.
DB_POOL_MAX=

LOG_LEVEL=info

# ── 기능을 켜는 청크에서 채웁니다 ───────────────
SENS_SERVICE_ID=
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
BLOB_READ_WRITE_TOKEN=
ZOOM_ENC_KEY=
